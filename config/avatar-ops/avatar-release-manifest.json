      "environment variable values",
      "IAM tokens",
      "signed URLs",
      "private object paths",
      "raw identities",
      "service account emails"
    ],
    "allowOutput": [
      "aggregate counts",
      "sanitized drift fields",
      "Cloud Run latest ready revision name",
      "container image digest"
    ]
