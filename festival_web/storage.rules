rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validTicketId(ticketId) {
      return ticketId is string &&
        ticketId.size() >= 6 &&
        ticketId.size() <= 64 &&
        ticketId.matches('^[A-Z0-9]+$');
    }

    match /ai_profiles/{gender}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /festivalProfiles/{ticketId}/{uid}/{fileName} {
      allow read: if signedIn() && validTicketId(ticketId);
      allow write: if signedIn() &&
        uid == request.auth.uid &&
        validTicketId(ticketId) &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
