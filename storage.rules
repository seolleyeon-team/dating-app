rules_version = '2';

// 설레연 Firebase Storage 보안 규칙
//
// 원본·생성 중 아바타는 Cloud Functions/Admin SDK 전용으로 유지하고,
// 승인된 아바타만 전용 공개 버킷에서 읽을 수 있다.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isApprovedAvatarBucket() {
      return bucket == "seolleyeon-approved-avatars" ||
          bucket == "seolleyeon-final-approved-avatars" ||
          bucket == "seolleyeon-festival-approved-avatars";
    }

    // AI 취향 학습용 프로필은 로그인 사용자만 읽을 수 있다.
    match /ai_profiles/{rest=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 원본 사진과 생성 파이프라인 데이터는 모두 서버 전용이다.
    match /users/{userId}/onboarding/photos/{fileName} {
      allow read, write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{userId}/source/{fileName} {
      allow read, write: if false;
    }

    match /users/{userId}/chat-profile/{fileName} {
      allow read, write: if false;
    }

    match /users/{userId}/jobs/{jobId}/candidates/{candidateId} {
      allow read, write: if false;
    }

    // 승인된 아바타만 공개 버킷에서 읽을 수 있으며 쓰기는 서버 전용이다.
    match /users/{userId}/avatar/{avatarId} {
      allow read: if isApprovedAvatarBucket();
      allow write: if false;
    }

    match /approved_avatars/{userId}/{allPaths=**} {
      allow read: if isApprovedAvatarBucket();
      allow write: if false;
    }

    match /avatar_temp/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /private_source_photos/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /chat_profile_photos/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
