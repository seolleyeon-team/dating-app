rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isYonseiEmail(email) {
      return email != null && email.matches('^.+@yonsei\\.ac\\.kr$');
    }

    // -----------------------------------------------------------------------
    // 공통 헬퍼 (2026-07 권한 하드닝)
    //
    // 이전 규칙은 "카카오 로그인은 커스텀 토큰 교환이 실패하면 비인증 상태로
    // 계속 진행된다"는 전제 위에 세워져 있었다. 그래서 users / chat_rooms /
    // messages / recEvents / deviceTokens / blocks / reports / asks /
    // interactions 가 모두 `if true` 였다.
    //
    // 그 fallback 은 제거했다. 앱은 카카오 로그인 후
    // createFirebaseCustomToken 으로 uid == kakaoUserId 인 Firebase 세션을
    // 반드시 확보하고, 실패하면 인증 영역에 진입하지 않는다. 따라서 아래
    // 규칙들은 request.auth 를 신뢰할 수 있다.
    // -----------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 클라이언트가 절대 직접 쓸 수 없는 필드.
    // 학교 인증 상태·계정 상태·권한·매너 점수는 서버(Admin SDK)만 바꾼다.
    // Admin SDK 는 규칙을 우회하므로 서버 기능에는 영향이 없다.
    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'isStudentVerified',
            'studentEmail',
            'studentVerifiedAt',
            'verifiedAt',
            'loginDisabled',
            'role',
            'roles',
            'permissions',
            'isAdmin',
            'isModerator',
            'isStaff',
            'premium',
            'paid',
            'trustScore',
            'mannerScore',
            'riskLevel',
            'moderationStatus',
            'rejoinRestricted',
            'rejoinRestrictedUntil',
            'rejoinRestrictionReason'
          ]);
    }

    // 탈퇴 관련 필드(status / isWithdrawn / withdrawnAt /
    // scheduledHardDeleteAt / withdrawalReason / profileVisible / canRejoin)는
    // 위 목록에서 의도적으로 제외했다. 현재 탈퇴는 클라이언트가 자기 문서를
    // 직접 수정하는 self-service 흐름이고, 이걸 막으면 회원 탈퇴와 개인정보
    // 삭제 요청이 동작하지 않는다. isSelf 로 남의 문서는 못 건드리게 됐으므로
    // 남는 위험은 "자기 계정의 status 를 스스로 바꿀 수 있다"뿐이다.
    // 정지(suspended) 상태를 스스로 해제할 여지가 있어서 탈퇴·정지 전이는
    // callable 로 옮겨야 한다. → R-FS-3

    // -----------------------------------------------------------------------
    // Email-link token exchange (앱 -> Firestore token 저장, Web -> token 조회)
    // -----------------------------------------------------------------------
    // 이 문서는 "credential" 이 아니라 lookup table 이다. 이메일 링크를 클릭한
    // 브라우저가 어떤 kakaoUserId 를 인증하려는지 알아내기 위해서만 쓴다.
    // 실제 이메일 소유 증명은 web 이 수행하는 signInWithEmailLink 이다.
    //
    // 이전 규칙은 create 에 request.auth 조건이 아예 없었고 hasAll 이라 필드
    // 주입도 가능했다. 그 상태에서 서버의
    // createFirebaseCustomTokenFromEmailLinkToken 이 이 문서를 bearer
    // credential 로 신뢰했기 때문에 임의 계정 탈취가 가능했다. 그 callable 은
    // 제거했고, 여기서는 문서를 생성자 본인에게 묶어 같은 위조를 원천 차단한다.
    match /emailLinkTokens/{token} {
      allow create: if isSelf(request.resource.data.kakaoUserId) &&
          request.resource.data.email is string &&
          isYonseiEmail(request.resource.data.email) &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.keys().hasOnly([
            'email',
            'kakaoUserId',
            'createdAt',
            'expiresAt'
          ]);

      // get 은 인증 없이 허용해야 한다. 웹은 signInWithEmailLink 를 하기 전에
      // 이 문서를 읽어서 email 을 알아내야 하고, 그 시점에는 세션이 없다.
      // 문서 ID 는 클라이언트가 만든 UUIDv4(122비트)이고 만료는 30분이다.
      // 남는 위험(문서 ID 를 아는 사람에게 email + kakaoUserId 노출)은
      // docs/audits/opus5/11-residual-risks.md 의 R-FS-1 로 기록했다.
      allow get: if true;
      allow list: if false;
      allow update: if false;
      // 이전에는 아무 인증 사용자나 남의 토큰을 지울 수 있었다 (인증 방해).
      allow delete: if isSelf(resource.data.kakaoUserId);
    }

        // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------
    // users 문서에 kakaoUserId 필드가 없으면 규칙에서 null 로 평가됨 -> 프로필 수정 허용
    function usersDocKakaoIdOk(data, docKakaoId) {
      return data.kakaoUserId == null || data.kakaoUserId == docKakaoId;
    }

    function isVerifiedOwner(kakaoUserId) {
      return request.auth != null &&
          request.auth.uid == kakaoUserId;
    }

    match /users/{kakaoUserId} {
      // 이전: get/list 모두 `if true`. 비로그인 상태에서 전체 사용자 문서를
      // 나열할 수 있었고 studentEmail·onboarding(나이·학과·관심사) 같은 PII 가
      // 그대로 노출됐다. 이것이 계정 탈취 체인의 1단계였다.
      //
      // 프로필 탐색·추천 카드가 다른 사용자 문서를 읽어야 하므로 get 은
      // 소유자 전용으로 만들 수 없다. 인증 필수로만 좁힌다. 필드 단위 분리
      // (publicProfiles 프로젝션)는 스키마 변경이 필요해서 후속 과제로 남겼다.
      // → docs/audits/opus5/11-residual-risks.md R-FS-2
      allow get: if isSignedIn();

      // list 는 ai_recommendation_service 의 fallback 후보 조회(limit 30)만
      // 필요하다. 익명 나열을 막고 페이지 크기를 제한한다.
      allow list: if isSignedIn() && request.query.limit <= 30;

      // 연세 메일 학생 인증으로 최초 생성
      allow create: if request.auth != null &&
          isYonseiEmail(request.auth.token.email) &&
          request.resource.data.keys().hasOnly([
            'kakaoUserId',
            'isStudentVerified',
            'studentEmail',
            'studentVerifiedAt',
            'verifiedAt'
          ]) &&
          (request.resource.data.kakaoUserId == null ||
            request.resource.data.kakaoUserId == kakaoUserId) &&
          request.resource.data.studentEmail is string &&
          isYonseiEmail(request.resource.data.studentEmail) &&
          request.resource.data.isStudentVerified == true;

      // 카카오 로그인 후 users/{kakaoUserId} 최초 생성.
      // 이전에는 request.auth 조건이 없어서 누구나 임의 UID 의 사용자 문서를
      // 만들 수 있었다. 이제 커스텀 토큰 세션(uid == kakaoUserId)을 요구한다.
      allow create: if isSelf(kakaoUserId) &&
          usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
          request.resource.data.keys().hasOnly([
            'kakaoUserId',
            'nickname',
            'profileImageUrl',
            'email',
            'createdAt',
            'lastLoginAt',
            'lastActivePlatform',
            'lastActivePlatformUpdatedAt',
            'onboarding',
            'onboardingUpdatedAt',
            'initialSetupComplete',
            'initialSetupCompletedAt',
            'onboardingCompletedAt',
            'idealType',
            'idealTypeUpdatedAt',
            'updatedAt',
            'hasSeenTutorial',
            'isStudentVerified',
            'studentEmail',
            'studentVerifiedAt',
            'verifiedAt',
            'legalConsents',
            'privacySettings',
            'privacySettingsUpdatedAt',
            'notificationSettings',
            'notificationSettingsUpdatedAt',
            'preferenceVector'
          ]);

      allow update: if (
            request.auth != null &&
            isYonseiEmail(request.auth.token.email) &&
            request.resource.data.studentEmail is string &&
            isYonseiEmail(request.resource.data.studentEmail) &&
            request.resource.data.isStudentVerified == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'isStudentVerified',
              'studentEmail',
              'studentVerifiedAt',
              'verifiedAt'
            ])
          ) || (
            // 본인 문서의 탈퇴·재가입·로그인 메타 갱신.
            // 이전에는 request.auth 조건이 없어서 누구나 임의 사용자의
            // isStudentVerified / loginDisabled / status 를 바꿀 수 있었다.
            isSelf(kakaoUserId) &&
            !touchesProtectedUserFields() &&
            resource.data.isStudentVerified == true &&
            request.resource.data.isStudentVerified == true &&
            usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'profileImageUrl',
              'email',
              'studentEmail',
              'isStudentVerified',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'status',
              'isWithdrawn',
              'withdrawnAt',
              'scheduledHardDeleteAt',
              'withdrawalRetentionDays',
              'withdrawalReason',
              'withdrawalPolicy',
              'profileVisible',
              'canRejoin',
              'rejoinRestricted',
              'rejoinRestrictedUntil',
              'rejoinRestrictionReason',
              'rejoinedAt',
              'lastLoginAt',
              'hasSeenTutorial',
              'loginDisabled',
              'updatedAt'
            ])
          ) || (
            // 프로필 수정(온보딩 데이터 갱신).
            // 이전에는 이 분기에도 request.auth 조건이 없었다.
            isSelf(kakaoUserId) &&
            !touchesProtectedUserFields() &&
            (request.resource.data.kakaoUserId == null ||
              request.resource.data.kakaoUserId == kakaoUserId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'profileImageUrl',
              'email',
              'studentEmail',
              'isStudentVerified',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'status',
              'isWithdrawn',
              'withdrawnAt',
              'scheduledHardDeleteAt',
              'withdrawalRetentionDays',
              'withdrawalReason',
              'withdrawalPolicy',
              'profileVisible',
              'canRejoin',
              'rejoinRestricted',
              'rejoinRestrictedUntil',
              'rejoinRestrictionReason',
              'rejoinedAt',
              'lastLoginAt',
              'hasSeenTutorial',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'studentVerifiedAt',
              'verifiedAt',
              'loginDisabled',
              'updatedAt'
            ])
          );

      // ---------------------------------------------------------------------
      // Device tokens
      // ---------------------------------------------------------------------
      // 이전: get/list/delete 가 `if true`, create/update 에 request.auth 조건
      // 없음. FCM 토큰이 전역 공개였고 남의 uid 아래에 자기 토큰을 등록할 수
      // 있었다. shared/notify.ts 의 fetchUserTokens 는 이 문서 ID 를 그대로
      // 수신자로 쓰기 때문에, 공격자가 피해자의 푸시(채팅 원문 포함)를
      // 받아볼 수 있었고 남의 토큰을 지워 푸시를 막을 수도 있었다.
      match /deviceTokens/{token} {
        allow get, list: if isSelf(kakaoUserId);

        allow create, update: if isSelf(kakaoUserId) &&
          request.resource.data.userId is string &&
          request.resource.data.userId == kakaoUserId &&
          request.resource.data.token is string &&
          request.resource.data.token == token;

        allow delete: if isSelf(kakaoUserId);
      }

      // ---------------------------------------------------------------------
      // In-app notifications
      // users/{kakaoUserId}/notifications/{notificationId}
      // ---------------------------------------------------------------------
      // 이전: get/list/delete 가 `if true`, create 에 request.auth 조건 없음.
      // 누구나 남의 알림함을 읽고 지울 수 있었고 임의 사용자에게 알림을
      // 꽂아넣을 수 있었다(스팸·피싱 문구 삽입).
      // 서버는 Admin SDK 로 쓰기 때문에 규칙을 우회하므로 영향이 없다.
      match /notifications/{notificationId} {
        allow get, list: if isSelf(kakaoUserId);

        // 자기 알림함에만 쓸 수 있다 (타 사용자 스팸 차단).
        allow create: if isSelf(kakaoUserId) &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.isRead is bool;

        allow update: if isSelf(kakaoUserId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'readAt'
          ]);

        allow delete: if isSelf(kakaoUserId);
      }

      // ---------------------------------------------------------------------
      // Friends mirror
      // users/{kakaoUserId}/friends/{friendUid}
      // ---------------------------------------------------------------------
      match /friends/{friendUid} {
        allow get, list: if isVerifiedOwner(kakaoUserId);
        allow create, update, delete: if false;
      }

      // ---------------------------------------------------------------------
      // Contact blocked hashes (연락처 차단 - server-side callable로만 쓰기)
      // users/{kakaoUserId}/contactBlockedHashes/{phoneHash}
      // ---------------------------------------------------------------------
      match /contactBlockedHashes/{phoneHash} {
        allow get, list: if request.auth != null &&
          request.auth.uid == kakaoUserId;
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Friend invites / friendships
    // -----------------------------------------------------------------------
    match /friendInvites/{inviteId} {
      allow get, list, create, update, delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // RecEvents (추천 학습용 이벤트 로그: open, like, nope 등)
    // -----------------------------------------------------------------------
    // 이전: `allow read, write: if true` — 모든 사용자의 행동 로그를 누구나
    // 읽고 쓸 수 있었다. onRecEventCreated 트리거가 이 문서의 userId 를 행위자로
    // 신뢰해서 위조된 like 로 실제 matches 문서를 만들 수 있었다.
    // 이제 본인 경로만 허용하고 문서의 userId 도 경로와 일치해야 한다.
    match /recEvents/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);

      match /events/{eventId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) &&
            (request.resource.data.userId == null ||
              request.resource.data.userId == userId);
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Chat
    //
    // 블라인드 취향 미팅 채팅방(roomType이 blind_meeting_*)은 서버가 멤버십과
    // 읽기 전용 여부를 관리하므로 클라이언트 쓰기를 별도로 제한한다.
    // -----------------------------------------------------------------------
    function blindMeetingRoomTypes() {
      return ['blind_meeting_group', 'blind_meeting_direct'];
    }

    function isBlindMeetingRoomData(data) {
      return data != null && data.roomType in blindMeetingRoomTypes();
    }

    function blindRoomData(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
    }

    function isRoomParticipant(roomId) {
      return request.auth != null &&
          request.auth.uid in blindRoomData(roomId).participantIds;
    }

    // 이전: chat_rooms 와 messages 모두 `allow read: if true` 였다. 인증 없이
    // 전체 사용자의 채팅 원문을 읽을 수 있었다. 또 블라인드 미팅이 아닌 방은
    // create/update 에 조건이 사실상 없어서 누구나 방을 만들고 남의 이름으로
    // 메시지를 넣을 수 있었다.
    //
    // 참가자 모델: chat_rooms 문서의 participantIds 배열.
    // 목록 조회는 where('participantIds' arrayContains uid) 로 하므로
    // 문서 단위 규칙과 맞는다 (chat_service.dart:61 / :69).
    //
    // 블라인드 미팅 방의 기존 조건은 그대로 유지한다. 아래 변경은 모든
    // roomType 에 참가자 게이트를 추가하는 것이고, 블라인드 전용 추가 조건은
    // 손대지 않았다. 회귀는 blind_meeting_rules.test.js 로 확인해야 한다.
    match /chat_rooms/{roomId} {
      allow read: if request.auth != null &&
          request.auth.uid in resource.data.participantIds;

      // 블라인드 미팅 채팅방은 서버만 생성한다.
      // 그 밖의 방은 자신이 참가자인 방만 만들 수 있다.
      allow create: if !isBlindMeetingRoomData(request.resource.data) &&
          request.auth != null &&
          request.auth.uid in request.resource.data.participantIds;

      // participantIds 는 어떤 roomType 이든 클라이언트가 못 바꾼다.
      // (멤버십을 추가해 남의 방에 들어가는 것을 막는다)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds &&
        (!isBlindMeetingRoomData(resource.data) || (
          resource.data.writable == true &&
          request.resource.data.roomType == resource.data.roomType &&
          request.resource.data.writable == resource.data.writable &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.meetingId == resource.data.meetingId
        ));

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isRoomParticipant(roomId);

        // senderId 위조 차단. 다만 클라이언트가 'system' 발신자로 안내
        // 메시지를 쓰는 기존 경로가 4곳 있어서(chat_service.dart:133,
        // lib/services/chat_service.dart:129 / :140, user_service.dart:323)
        // 'system' 은 허용한다. 이건 시스템 메시지 위조 여지를 남기므로
        // 서버 발행으로 옮겨야 한다. → R-CHAT-SYSTEM
        allow create: if isRoomParticipant(roomId) &&
          (request.resource.data.senderId == request.auth.uid ||
            request.resource.data.senderId == 'system') &&
          (!isBlindMeetingRoomData(blindRoomData(roomId)) || (
            blindRoomData(roomId).writable == true &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 1000
          ));

        allow update: if isRoomParticipant(roomId) && (
          !isBlindMeetingRoomData(blindRoomData(roomId)) || (
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.text == resource.data.text
          )
        );

        allow delete: if false;
      }

      match /promises/{promiseId} {
        allow read: if isRoomParticipant(roomId);

        allow create, update: if isRoomParticipant(roomId) &&
          (!isBlindMeetingRoomData(blindRoomData(roomId)) ||
            blindRoomData(roomId).writable == true);

        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // 3:3 블라인드 취향 미팅
    //
    //  - 비공개 미팅 DNA는 본인만 읽을 수 있고 클라이언트 쓰기는 전면 금지
    //  - 미팅 상태·팀 배열·결제·참석 상태는 서버(Cloud Functions)만 변경
    //  - 내부 매칭 점수는 클라이언트에서 읽을 수 없음
    //  - 후속 선택은 본인 문서만 읽기 가능, 상호 선택 판정은 서버 전용
    // -----------------------------------------------------------------------
    function isBlindOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function blindMeetingData(meetingId) {
      return get(/databases/$(database)/documents/blindMeetings/$(meetingId)).data;
    }

    function isBlindMeetingParticipant(meetingId) {
      return request.auth != null &&
          request.auth.uid in blindMeetingData(meetingId).participantIds;
    }

    // 비공개 미팅 DNA: 본인 읽기만, 쓰기는 callable(submitBlindMeetingApplication)만
    match /blindMeetingDna/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 신청 상태: 본인 읽기만
    match /blindMeetingApplications/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetings/{meetingId} {
      // 자신이 참가한 미팅만 조회 가능
      allow get, list: if request.auth != null &&
          request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      // 참가자 상태: 본인 문서만 읽기, 쓰기는 서버만
      match /participants/{userId} {
        allow get: if isBlindOwner(userId) ||
            isBlindMeetingParticipant(meetingId);
        allow list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 공개 프로필 스냅샷 (얼굴 사진·비공개 DNA 없음)
      match /publicProfiles/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 내부 매칭 점수: 서버 전용
      match /matchingResult/{docId} {
        allow read, write: if false;
      }

      // 후속 선택: 자신의 선택만 읽기, 쓰기는 callable만
      match /followUpChoices/{chooserUid} {
        allow get: if isBlindOwner(chooserUid);
        allow list: if false;
        allow create, update, delete: if false;
      }

      // 상호 선택 결과: callable(getBlindMeetingMutualMatches)로만 조회
      match /mutualMatches/{pairId} {
        allow read, write: if false;
      }

      match /feedback/{userId} {
        allow get: if isBlindOwner(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /scheduleVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      match /fivePersonVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }
    }

    // 대체 참가 제안: 제안받은 본인만 조회
    match /blindMeetingReplacementOffers/{offerId} {
      allow get: if request.auth != null &&
          request.auth.uid == resource.data.candidateUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 참여 제한 / 통계: 본인 읽기만
    match /blindMeetingRestrictions/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetingStats/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;

      match /noShows/{meetingId} {
        allow read, write: if false;
      }
    }

    match /blindMeetingHistory/{userId} {
      allow read, write: if false;
      match /metUsers/{otherUid} {
        allow read, write: if false;
      }
    }

    // 결제/환불, 안전 flag, 운영 검토, 알림 발송 로그: 서버 전용
    match /blindMeetingDeposits/{depositId} {
      allow read, write: if false;
    }

    match /blindMeetingSafetyFlags/{meetingId} {
      allow read, write: if false;
    }

    match /blindMeetingOpsReviews/{reviewId} {
      allow read, write: if false;
    }

    match /notificationDispatchLog/{dispatchKey} {
      allow read, write: if false;
    }

    // 운영 설정(보증금 금액 등)은 읽기 전용으로 공개
    match /blindMeetingConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Analytics: 개인정보 없는 이벤트만 append. 조회는 서버/운영 전용.
    match /blindMeetingAnalytics/{eventId} {
      allow create: if
          request.resource.data.event is string &&
          request.resource.data.event.size() > 0 &&
          request.resource.data.event.matches('^blind_meeting_[a-z0-9_]+$') &&
          request.resource.data.params is map &&
          !('nickname' in request.resource.data.params) &&
          !('interests' in request.resource.data.params) &&
          !('userId' in request.resource.data.params) &&
          !('studentEmail' in request.resource.data.params);
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // 3:3 미팅 아이스브레이킹 룰렛 (시즌 미팅 / 블라인드 취향 미팅 전용)
    //
    //  - 15분 반복 알림 상태는 서버(Cloud Functions)만 만들고 바꾼다
    //  - 참가자는 자신의 문서만 읽는다 (다른 참가자의 알림 설정은 비공개)
    //  - "이번 미팅 알림 끄기"는 callable(meetingIcebreakerAction)만 처리한다
    // -----------------------------------------------------------------------
    match /meetingIcebreakerSessions/{sessionId} {
      // 세션 메타(원본 미팅 참조)는 클라이언트가 직접 읽지 않는다.
      allow read: if false;
      allow create, update, delete: if false;

      match /promptParticipants/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        // isActive / nextPromptAt / promptSequence / stopReason 는 서버 전용
        allow create, update, delete: if false;
      }
    }

    // 운영 설정(알림 주기, 최대 지속 시간, feature flag)은 읽기 전용으로 공개
    match /meetingIcebreakerConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Analytics: 개인정보와 폭탄 숨겨진 시간이 없는 이벤트만 append.
    match /meetingIcebreakerAnalytics/{eventId} {
      allow create: if
          request.resource.data.event is string &&
          request.resource.data.event.size() > 0 &&
          request.resource.data.event.matches('^(meeting_icebreaker|meeting_roulette|meeting_game|bomb_timer)_[a-z0-9_]+$') &&
          request.resource.data.params is map &&
          !('nickname' in request.resource.data.params) &&
          !('userId' in request.resource.data.params) &&
          !('participantIds' in request.resource.data.params) &&
          !('place' in request.resource.data.params) &&
          !('hiddenSeconds' in request.resource.data.params) &&
          !('bombSeconds' in request.resource.data.params) &&
          !('fcmToken' in request.resource.data.params);
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Bamboo Forest (Community)
    // -----------------------------------------------------------------------
    // 이전: create 에 request.auth 조건이 없어서 authorId 를 위조해 남의
    // 이름으로 글을 쓸 수 있었고, update 2번째 분기가 카운터를 보호하지 않아
    // likeCount / commentCount / score7d 를 임의 값으로 바꿀 수 있었다
    // (인기 순위 조작).
    match /bamboo_posts/{postId} {
      allow get, list: if isSignedIn();

      allow create: if isSelf(request.resource.data.authorId) &&
        request.resource.data.postId is string &&
        request.resource.data.authorId is string &&
        request.resource.data.authorId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.tags is list &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.score7d == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if isSignedIn() && (
          (
            // 작성자 본인의 soft delete
            isSelf(resource.data.authorId) &&
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.isDeleted == true
          )
          ||
          (
            // 좋아요·댓글 카운터 갱신. 한 번에 ±1 만 허용하고
            // score7d 는 서버(Admin SDK)만 바꾼다.
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.content == resource.data.content &&
            request.resource.data.category == resource.data.category &&
            request.resource.data.tags == resource.data.tags &&
            request.resource.data.isDeleted == resource.data.isDeleted &&
            request.resource.data.score7d == resource.data.score7d &&
            request.resource.data.likeCount >= resource.data.likeCount - 1 &&
            request.resource.data.likeCount <= resource.data.likeCount + 1 &&
            request.resource.data.commentCount >= resource.data.commentCount - 1 &&
            request.resource.data.commentCount <= resource.data.commentCount + 1
          )
        );

      allow delete: if false;

      // ---------------------------------------------------------------------
      // Post likes
      // ---------------------------------------------------------------------
      // 이전: 익명 read, create 에 auth 조건 없음, delete 가 `if true` 여서
      // 남의 좋아요를 취소할 수 있었다.
      match /likes/{userId} {
        allow get, list: if isSignedIn();

        allow create: if isSelf(userId) &&
          request.resource.data.userId is string &&
          request.resource.data.userId == userId;

        allow delete: if isSelf(userId);
        allow update: if false;
      }

      // ---------------------------------------------------------------------
      // Comments / Replies
      // ---------------------------------------------------------------------
      match /comments/{commentId} {
        allow get, list: if isSignedIn();

        allow create: if isSelf(request.resource.data.authorId) &&
          request.resource.data.commentId is string &&
          request.resource.data.authorId is string &&
          request.resource.data.authorId.size() > 0 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500 &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.isDeleted == false;

        allow update: if isSignedIn() && (
            (
              isSelf(resource.data.authorId) &&
              resource.data.authorId == request.resource.data.authorId &&
              request.resource.data.isDeleted == true
            )
            ||
            (
              request.resource.data.authorId == resource.data.authorId &&
              request.resource.data.content == resource.data.content &&
              request.resource.data.parentCommentId == resource.data.parentCommentId &&
              request.resource.data.isDeleted == resource.data.isDeleted &&
              request.resource.data.likeCount >= resource.data.likeCount - 1 &&
              request.resource.data.likeCount <= resource.data.likeCount + 1
            )
          );

        allow delete: if false;

        // -------------------------------------------------------------------
        // Comment likes
        // -------------------------------------------------------------------
        match /likes/{userId} {
          allow get, list: if isSignedIn();

          allow create: if isSelf(userId) &&
            request.resource.data.userId is string &&
            request.resource.data.userId == userId;

          allow delete: if isSelf(userId);
          allow update: if false;
        }
      }
    }

    // -----------------------------------------------------------------------
    // Blocks and Reports
    // -----------------------------------------------------------------------
    // 이전: 모든 verb 가 `if true` — 누구나 남의 차단 목록을 읽고, 무엇보다
    // 남이 나를 차단한 기록을 지울 수 있었다. 차단 해제는 피해자 보호를
    // 직접 무너뜨리므로 소유자 전용으로 닫는다.
    match /blocks/{viewerUid} {
      allow read: if isSelf(viewerUid);
      allow create, update: if isSelf(viewerUid);
      allow delete: if isSelf(viewerUid);

      match /targets/{targetUid} {
        allow read: if isSelf(viewerUid);
        allow create, update: if isSelf(viewerUid) &&
          request.resource.data.fromUserId is string &&
          request.resource.data.toUserId is string &&
          request.resource.data.fromUserId == viewerUid &&
          request.resource.data.toUserId == targetUid;
        allow delete: if isSelf(viewerUid);
      }
    }

    // 이전: read/update/delete 가 모두 `if true`. 누구나 전체 신고 내역을 읽고
    // 상태를 바꾸고 삭제할 수 있었다. 피신고자가 자기 신고를 지우는 것이
    // 가능했다는 뜻이다.
    //
    // 신고자 본인도 read 를 주지 않는다. 신고 문서에는 moderation 상태와
    // 피신고자 정보가 함께 들어가기 때문이다. 운영 조회는 Admin SDK 로 한다.
    match /reports/{reportId} {
      allow create: if isSelf(request.resource.data.reporterId) &&
        request.resource.data.reportedId is string &&
        request.resource.data.reportedId.size() > 0 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.status is string;
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 이전: read/update/delete 가 모두 `if true`.
    // 본인이 낸 문의는 본인이 볼 수 있어야 하므로 소유자 스코프 read 만 남긴다.
    // 상태 변경과 삭제는 서버 전용이다.
    match /app_issue_reports/{reportId} {
      allow create: if isSelf(request.resource.data.reporterId) &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if isSelf(resource.data.reporterId);
      allow update: if false;
      allow delete: if false;
    }

    // 이전: read/update/delete 가 모두 `if true`.
    match /app_inquiries/{inquiryId} {
      allow create: if isSelf(request.resource.data.inquirerId) &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if isSelf(resource.data.inquirerId);
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // User Private (전화번호 해시 등 민감 정보 - server callable로만 쓰기)
    // -----------------------------------------------------------------------
    match /userPrivate/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Phone Hash Index (역매칭 - server/admin only)
    // -----------------------------------------------------------------------
    match /phoneHashIndex/{phoneHash} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Contact Blocked Hash Index (연락처 차단 역인덱스 - server/admin only)
    // -----------------------------------------------------------------------
    match /contactBlockedHashIndex/{phoneHash} {
      allow read, write: if false;
      match /owners/{ownerUid} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------------
    // AI Profiles (더미 프로필 메타데이터: height 등, AI 취향 화면용)
    // -----------------------------------------------------------------------
    match /ai_profiles/{profileId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Model Recs (AI 추천 결과: rrf, clip, svd, knn - 서버에서 저장, 앱에서 읽기)
    // Kakao 로그인 시 request.auth가 null일 수 있어 read는 허용
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` — 누구나 임의 사용자의 추천 결과를 읽을 수
    // 있었다. 추천 결과에는 candidateUid 목록과 source score 가 들어간다.
    match /modelRecs/{userId}/daily/{dateKey}/sources/{algo} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Asks (무물: 1:1 질문)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` 로 전체 무물 내용이 공개였고, create 에
    // request.auth 조건이 없어서 fromUserId 를 위조해 남의 이름으로 질문을
    // 보낼 수 있었다. update 도 아무나 상태를 바꿀 수 있었다.
    match /asks/{askId} {
      allow read: if request.auth != null && (
          request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == resource.data.toUserId
        );

      allow create: if isSelf(request.resource.data.fromUserId) &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.status is string;

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == resource.data.toUserId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'readAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Interactions (like / nope / view / message)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` 로 전체 like/nope 기록이 공개였고, create 에
    // request.auth 조건이 없어서 fromUserId 를 위조할 수 있었다. 위조된 like 는
    // onInteractionCreated(index.ts:2304)를 통해 실제 매치와 채팅방을 만들었다.
    match /interactions/{interactionId} {
      allow read: if request.auth != null && (
          request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == resource.data.toUserId
        );
      allow create: if isSelf(request.resource.data.fromUserId) &&
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId.size() > 0 &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.action is string &&
        request.resource.data.source is string &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'action', 'source',
          'metadata', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Matches (매치 성사 기록)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` — 누구나 전체 매치 기록을 볼 수 있었다.
    match /matches/{matchId} {
      allow read: if request.auth != null &&
          request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.userIds &&
        request.resource.data.userIds is list &&
        request.resource.data.userIds.size() == 2 &&
        request.resource.data.matchType is string &&
        request.resource.data.status is string &&
        request.resource.data.keys().hasOnly([
          'userIds', 'matchType', 'matchedAt', 'status', 'chatRoomId'
        ]);
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.userIds &&
        request.resource.data.userIds == resource.data.userIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'unmatchedAt',
          'chatRoomId'
        ]);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Event 3인 팀 (초대·상태 - 쓰기는 Cloud Functions만, 읽기는 앱 동기화용)
    // -----------------------------------------------------------------------
    match /eventTeamSetups/{teamSetupId} {
      allow read: if true;
      allow write: if false;
    }

    match /eventTeamInvites/{inviteId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
