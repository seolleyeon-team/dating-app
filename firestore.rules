rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isYonseiEmail(email) {
      return email != null && email.matches('^.+@yonsei\\.ac\\.kr$');
    }

    // -----------------------------------------------------------------------
    // Email-link token exchange (앱 -> Firestore token 저장, Web -> token 조회)
    // -----------------------------------------------------------------------
    match /emailLinkTokens/{token} {
      allow create: if request.resource.data.email is string &&
          request.resource.data.kakaoUserId is string &&
          isYonseiEmail(request.resource.data.email) &&
          request.resource.data.keys().hasAll([
            'email',
            'kakaoUserId',
            'createdAt',
            'expiresAt'
          ]);

      allow get: if true;
      allow list: if false;
      allow update: if false;
      allow delete: if request.auth != null;
    }

        // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------
    // users 문서에 kakaoUserId 필드가 없으면 규칙에서 null 로 평가됨 -> 프로필 수정 허용
    function usersDocKakaoIdOk(data, docKakaoId) {
      return data.kakaoUserId == null || data.kakaoUserId == docKakaoId;
    }

    function isVerifiedOwner(kakaoUserId) {
      return request.auth != null &&
          request.auth.uid == kakaoUserId;
    }

    match /users/{kakaoUserId} {
      allow get: if true;
      allow list: if true;

      // 연세 메일 학생 인증으로 최초 생성
      allow create: if request.auth != null &&
          isYonseiEmail(request.auth.token.email) &&
          request.resource.data.keys().hasOnly([
            'kakaoUserId',
            'isStudentVerified',
            'studentEmail',
            'studentVerifiedAt',
            'verifiedAt'
          ]) &&
          (request.resource.data.kakaoUserId == null ||
            request.resource.data.kakaoUserId == kakaoUserId) &&
          request.resource.data.studentEmail is string &&
          isYonseiEmail(request.resource.data.studentEmail) &&
          request.resource.data.isStudentVerified == true;

      // 카카오 로그인 후 users/{kakaoUserId} 최초 생성 (Firebase Auth 없음)
      // saveOnboarding* 등은 문서 ID가 곧 kakaoUserId 이므로 필드 생략 가능
      allow create: if usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
          request.resource.data.keys().hasOnly([
            'kakaoUserId',
            'nickname',
            'profileImageUrl',
            'email',
            'createdAt',
            'lastLoginAt',
            'lastActivePlatform',
            'lastActivePlatformUpdatedAt',
            'onboarding',
            'onboardingUpdatedAt',
            'initialSetupComplete',
            'initialSetupCompletedAt',
            'onboardingCompletedAt',
            'idealType',
            'idealTypeUpdatedAt',
            'updatedAt',
            'hasSeenTutorial',
            'isStudentVerified',
            'studentEmail',
            'studentVerifiedAt',
            'verifiedAt',
            'legalConsents',
            'privacySettings',
            'privacySettingsUpdatedAt',
            'notificationSettings',
            'notificationSettingsUpdatedAt',
            'preferenceVector'
          ]);

      allow update: if (
            request.auth != null &&
            isYonseiEmail(request.auth.token.email) &&
            request.resource.data.studentEmail is string &&
            isYonseiEmail(request.resource.data.studentEmail) &&
            request.resource.data.isStudentVerified == true &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'isStudentVerified',
              'studentEmail',
              'studentVerifiedAt',
              'verifiedAt'
            ])
          ) || (
            resource.data.isStudentVerified == true &&
            request.resource.data.isStudentVerified == true &&
            usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'profileImageUrl',
              'email',
              'studentEmail',
              'isStudentVerified',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'status',
              'isWithdrawn',
              'withdrawnAt',
              'scheduledHardDeleteAt',
              'withdrawalRetentionDays',
              'withdrawalReason',
              'withdrawalPolicy',
              'profileVisible',
              'canRejoin',
              'rejoinRestricted',
              'rejoinRestrictedUntil',
              'rejoinRestrictionReason',
              'rejoinedAt',
              'lastLoginAt',
              'hasSeenTutorial',
              'loginDisabled',
              'updatedAt'
            ])
          ) || (
            // 프로필 수정(온보딩 데이터 갱신) - 기존 규칙 유지 + 온보딩 편집 허용
            (request.resource.data.kakaoUserId == null ||
              request.resource.data.kakaoUserId == kakaoUserId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'profileImageUrl',
              'email',
              'studentEmail',
              'isStudentVerified',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'status',
              'isWithdrawn',
              'withdrawnAt',
              'scheduledHardDeleteAt',
              'withdrawalRetentionDays',
              'withdrawalReason',
              'withdrawalPolicy',
              'profileVisible',
              'canRejoin',
              'rejoinRestricted',
              'rejoinRestrictedUntil',
              'rejoinRestrictionReason',
              'rejoinedAt',
              'lastLoginAt',
              'hasSeenTutorial',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'studentVerifiedAt',
              'verifiedAt',
              'loginDisabled',
              'updatedAt'
            ])
          );

      // ---------------------------------------------------------------------
      // Device tokens
      // ---------------------------------------------------------------------
      match /deviceTokens/{token} {
        allow get, list: if true;

        allow create, update: if
          request.resource.data.userId is string &&
          request.resource.data.userId == kakaoUserId &&
          request.resource.data.token is string &&
          request.resource.data.token == token;

        allow delete: if true;
      }

      // ---------------------------------------------------------------------
      // In-app notifications
      // users/{kakaoUserId}/notifications/{notificationId}
      // ---------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.isRead is bool;

        allow update: if
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'isRead',
            'readAt'
          ]);

        allow delete: if true;
      }

      // ---------------------------------------------------------------------
      // Friends mirror
      // users/{kakaoUserId}/friends/{friendUid}
      // ---------------------------------------------------------------------
      match /friends/{friendUid} {
        allow get, list: if isVerifiedOwner(kakaoUserId);
        allow create, update, delete: if false;
      }

      // ---------------------------------------------------------------------
      // Contact blocked hashes (연락처 차단 - server-side callable로만 쓰기)
      // users/{kakaoUserId}/contactBlockedHashes/{phoneHash}
      // ---------------------------------------------------------------------
      match /contactBlockedHashes/{phoneHash} {
        allow get, list: if request.auth != null &&
          request.auth.uid == kakaoUserId;
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Friend invites / friendships
    // -----------------------------------------------------------------------
    match /friendInvites/{inviteId} {
      allow get, list, create, update, delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // RecEvents (추천 학습용 이벤트 로그: open, like, nope 등)
    // -----------------------------------------------------------------------
    match /recEvents/{userId} {
      allow read, write: if true;

      match /events/{eventId} {
        allow read, write: if true;
      }
    }

    // -----------------------------------------------------------------------
    // Chat
    //
    // 블라인드 취향 미팅 채팅방(roomType이 blind_meeting_*)은 서버가 멤버십과
    // 읽기 전용 여부를 관리하므로 클라이언트 쓰기를 별도로 제한한다.
    // -----------------------------------------------------------------------
    function blindMeetingRoomTypes() {
      return ['blind_meeting_group', 'blind_meeting_direct'];
    }

    function isBlindMeetingRoomData(data) {
      return data != null && data.roomType in blindMeetingRoomTypes();
    }

    function blindRoomData(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
    }

    match /chat_rooms/{roomId} {
      allow read: if true;

      // 블라인드 미팅 채팅방은 서버만 생성한다.
      allow create: if !isBlindMeetingRoomData(request.resource.data);

      allow update: if !isBlindMeetingRoomData(resource.data) || (
        request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        resource.data.writable == true &&
        request.resource.data.roomType == resource.data.roomType &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.writable == resource.data.writable &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.meetingId == resource.data.meetingId
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;

        allow create: if !isBlindMeetingRoomData(blindRoomData(roomId)) || (
          request.auth != null &&
          request.auth.uid in blindRoomData(roomId).participantIds &&
          blindRoomData(roomId).writable == true &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000
        );

        allow update: if !isBlindMeetingRoomData(blindRoomData(roomId)) || (
          request.auth != null &&
          request.auth.uid in blindRoomData(roomId).participantIds &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.text == resource.data.text
        );

        allow delete: if false;
      }

      match /promises/{promiseId} {
        allow read: if true;

        allow create, update: if !isBlindMeetingRoomData(blindRoomData(roomId)) || (
          request.auth != null &&
          request.auth.uid in blindRoomData(roomId).participantIds &&
          blindRoomData(roomId).writable == true
        );

        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // 3:3 블라인드 취향 미팅
    //
    //  - 비공개 미팅 DNA는 본인만 읽을 수 있고 클라이언트 쓰기는 전면 금지
    //  - 미팅 상태·팀 배열·결제·참석 상태는 서버(Cloud Functions)만 변경
    //  - 내부 매칭 점수는 클라이언트에서 읽을 수 없음
    //  - 후속 선택은 본인 문서만 읽기 가능, 상호 선택 판정은 서버 전용
    // -----------------------------------------------------------------------
    function isBlindOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function blindMeetingData(meetingId) {
      return get(/databases/$(database)/documents/blindMeetings/$(meetingId)).data;
    }

    function isBlindMeetingParticipant(meetingId) {
      return request.auth != null &&
          request.auth.uid in blindMeetingData(meetingId).participantIds;
    }

    // 비공개 미팅 DNA: 본인 읽기만, 쓰기는 callable(submitBlindMeetingApplication)만
    match /blindMeetingDna/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 신청 상태: 본인 읽기만
    match /blindMeetingApplications/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetings/{meetingId} {
      // 자신이 참가한 미팅만 조회 가능
      allow get, list: if request.auth != null &&
          request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      // 참가자 상태: 본인 문서만 읽기, 쓰기는 서버만
      match /participants/{userId} {
        allow get: if isBlindOwner(userId) ||
            isBlindMeetingParticipant(meetingId);
        allow list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 공개 프로필 스냅샷 (얼굴 사진·비공개 DNA 없음)
      match /publicProfiles/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 내부 매칭 점수: 서버 전용
      match /matchingResult/{docId} {
        allow read, write: if false;
      }

      // 후속 선택: 자신의 선택만 읽기, 쓰기는 callable만
      match /followUpChoices/{chooserUid} {
        allow get: if isBlindOwner(chooserUid);
        allow list: if false;
        allow create, update, delete: if false;
      }

      // 상호 선택 결과: callable(getBlindMeetingMutualMatches)로만 조회
      match /mutualMatches/{pairId} {
        allow read, write: if false;
      }

      match /feedback/{userId} {
        allow get: if isBlindOwner(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /scheduleVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      match /fivePersonVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }
    }

    // 대체 참가 제안: 제안받은 본인만 조회
    match /blindMeetingReplacementOffers/{offerId} {
      allow get: if request.auth != null &&
          request.auth.uid == resource.data.candidateUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 참여 제한 / 통계: 본인 읽기만
    match /blindMeetingRestrictions/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetingStats/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;

      match /noShows/{meetingId} {
        allow read, write: if false;
      }
    }

    match /blindMeetingHistory/{userId} {
      allow read, write: if false;
      match /metUsers/{otherUid} {
        allow read, write: if false;
      }
    }

    // 결제/환불, 안전 flag, 운영 검토, 알림 발송 로그: 서버 전용
    match /blindMeetingDeposits/{depositId} {
      allow read, write: if false;
    }

    match /blindMeetingSafetyFlags/{meetingId} {
      allow read, write: if false;
    }

    match /blindMeetingOpsReviews/{reviewId} {
      allow read, write: if false;
    }

    match /notificationDispatchLog/{dispatchKey} {
      allow read, write: if false;
    }

    // 운영 설정(보증금 금액 등)은 읽기 전용으로 공개
    match /blindMeetingConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Analytics: 개인정보 없는 이벤트만 append. 조회는 서버/운영 전용.
    match /blindMeetingAnalytics/{eventId} {
      allow create: if
          request.resource.data.event is string &&
          request.resource.data.event.size() > 0 &&
          request.resource.data.event.matches('^blind_meeting_[a-z0-9_]+$') &&
          request.resource.data.params is map &&
          !('nickname' in request.resource.data.params) &&
          !('interests' in request.resource.data.params) &&
          !('userId' in request.resource.data.params) &&
          !('studentEmail' in request.resource.data.params);
      allow read, update, delete: if false;
    }
    
        // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if true;
      allow write: if false;
    }


    // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Bamboo Forest (Community)
    // -----------------------------------------------------------------------
    match /bamboo_posts/{postId} {
      allow get, list: if true;

      allow create: if
        request.resource.data.postId is string &&
        request.resource.data.authorId is string &&
        request.resource.data.authorId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.tags is list &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.score7d == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if
        (
          resource.data.authorId == request.resource.data.authorId &&
          request.resource.data.isDeleted == true
        )
        ||
        (
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.tags == resource.data.tags
        );

      allow delete: if false;

      // ---------------------------------------------------------------------
      // Post likes
      // ---------------------------------------------------------------------
      match /likes/{userId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.userId is string &&
          request.resource.data.userId == userId;

        allow delete: if true;
        allow update: if false;
      }

      // ---------------------------------------------------------------------
      // Comments / Replies
      // ---------------------------------------------------------------------
      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.commentId is string &&
          request.resource.data.authorId is string &&
          request.resource.data.authorId.size() > 0 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500 &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.isDeleted == false;

        allow update: if
          (
            resource.data.authorId == request.resource.data.authorId &&
            request.resource.data.isDeleted == true
          )
          ||
          (
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.content == resource.data.content &&
            request.resource.data.parentCommentId == resource.data.parentCommentId
          );

        allow delete: if false;

        // -------------------------------------------------------------------
        // Comment likes
        // -------------------------------------------------------------------
        match /likes/{userId} {
          allow get, list: if true;

          allow create: if
            request.resource.data.userId is string &&
            request.resource.data.userId == userId;

          allow delete: if true;
          allow update: if false;
        }
      }
    }

    // -----------------------------------------------------------------------
    // Blocks and Reports
    // -----------------------------------------------------------------------
    match /blocks/{viewerUid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /targets/{targetUid} {
        allow read: if true;
        allow create, update: if
          request.resource.data.fromUserId is string &&
          request.resource.data.toUserId is string &&
          request.resource.data.fromUserId == viewerUid &&
          request.resource.data.toUserId == targetUid;
        allow delete: if true;
      }
    }

    match /reports/{reportId} {
      allow create: if
        request.resource.data.reporterId is string &&
        request.resource.data.reportedId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.status is string;
      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /app_issue_reports/{reportId} {
      allow create: if
        request.resource.data.reporterId is string &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /app_inquiries/{inquiryId} {
      allow create: if
        request.resource.data.inquirerId is string &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    // -----------------------------------------------------------------------
    // User Private (전화번호 해시 등 민감 정보 - server callable로만 쓰기)
    // -----------------------------------------------------------------------
    match /userPrivate/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Phone Hash Index (역매칭 - server/admin only)
    // -----------------------------------------------------------------------
    match /phoneHashIndex/{phoneHash} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Contact Blocked Hash Index (연락처 차단 역인덱스 - server/admin only)
    // -----------------------------------------------------------------------
    match /contactBlockedHashIndex/{phoneHash} {
      allow read, write: if false;
      match /owners/{ownerUid} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------------
    // AI Profiles (더미 프로필 메타데이터: height 등, AI 취향 화면용)
    // -----------------------------------------------------------------------
    match /ai_profiles/{profileId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Model Recs (AI 추천 결과: rrf, clip, svd, knn - 서버에서 저장, 앱에서 읽기)
    // Kakao 로그인 시 request.auth가 null일 수 있어 read는 허용
    // -----------------------------------------------------------------------
    match /modelRecs/{userId}/daily/{dateKey}/sources/{algo} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Asks (무물: 1:1 질문)
    // -----------------------------------------------------------------------
    match /asks/{askId} {
      allow read: if true;

      allow create: if
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId.size() > 0 &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.status is string;

      allow update: if
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'readAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Interactions (like / nope / view / message)
    // -----------------------------------------------------------------------
    match /interactions/{interactionId} {
      allow read: if true;
      allow create: if
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId.size() > 0 &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.action is string &&
        request.resource.data.source is string &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'action', 'source',
          'metadata', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Matches (매치 성사 기록)
    // -----------------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if true;
      allow create: if
        request.resource.data.userIds is list &&
        request.resource.data.userIds.size() == 2 &&
        request.resource.data.matchType is string &&
        request.resource.data.status is string &&
        request.resource.data.keys().hasOnly([
          'userIds', 'matchType', 'matchedAt', 'status', 'chatRoomId'
        ]);
      allow update: if
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'unmatchedAt',
          'chatRoomId'
        ]);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Event 3인 팀 (초대·상태 - 쓰기는 Cloud Functions만, 읽기는 앱 동기화용)
    // -----------------------------------------------------------------------
    match /eventTeamSetups/{teamSetupId} {
      allow read: if true;
      allow write: if false;
    }

    match /eventTeamInvites/{inviteId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
