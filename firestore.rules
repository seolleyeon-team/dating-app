rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isYonseiEmail(email) {
      return email != null && email.matches('^.+@yonsei\\.ac\\.kr$');
    }

    // -----------------------------------------------------------------------
    // Email-link token exchange (앱 -> Firestore token 저장, Web -> token 조회)
    // -----------------------------------------------------------------------
    match /emailLinkTokens/{token} {
      allow create: if request.resource.data.email is string &&
          request.resource.data.kakaoUserId is string &&
          isYonseiEmail(request.resource.data.email) &&
          request.resource.data.keys().hasAll([
            'email',
            'kakaoUserId',
            'createdAt',
            'expiresAt'
          ]);

      allow get: if true;
      allow list: if false;
      allow update: if false;
      allow delete: if request.auth != null;
    }

        // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------
    // users 문서에 kakaoUserId 필드가 없으면 규칙에서 null 로 평가됨 -> 프로필 수정 허용
    function usersDocKakaoIdOk(data, docKakaoId) {
      return data.kakaoUserId == null || data.kakaoUserId == docKakaoId;
    }

    function isVerifiedOwner(kakaoUserId) {
      return request.auth != null &&
          request.auth.uid == kakaoUserId;
    }

    function isUserDocOwner(kakaoUserId) {
      return request.auth != null &&
          (
            request.auth.uid == kakaoUserId ||
            (
              request.auth.token.email is string &&
              request.auth.token.email_verified == true &&
              isYonseiEmail(request.auth.token.email) &&
              resource.data.studentEmail is string &&
              isYonseiEmail(resource.data.studentEmail) &&
              request.auth.token.email == resource.data.studentEmail
            )
          );
    }

    function isStorageSourcePath(value) {
      return value is string &&
          (
            value.lower().matches('^https://storage\\.googleapis\\.com/.*') ||
            value.lower().matches('^https://firebasestorage\\.googleapis\\.com/.*')
          ) &&
          (
            value.lower().matches('.*/source/.*') ||
            value.lower().matches('.*%2fsource%2f.*')
          );
    }

    function isSafePublicMediaUrl(value) {
      return value is string &&
          !value.lower().matches('^gs://.*') &&
          !value.lower().matches('^gcs://.*') &&
          !value.lower().matches('.*seolleyeon-private-source-photos.*') &&
          !value.lower().matches('.*seolleyeon-final-private-source-photos.*') &&
          !value.lower().matches('.*seolleyeon-avatar-temp.*') &&
          !value.lower().matches('.*seolleyeon-final-avatar-temp.*') &&
          !value.lower().matches('.*seolleyeon-chat-profile-photos.*') &&
          !value.lower().matches('.*seolleyeon-final-chat-profile-photos.*') &&
          !value.lower().matches('.*x-goog-.*') &&
          !value.lower().matches('.*x-amz-.*') &&
          !value.lower().matches('.*googleaccessid.*') &&
          !value.lower().matches('.*signature=.*') &&
          !value.lower().matches('.*expires=.*') &&
          !value.lower().matches('.*awsaccesskeyid.*') &&
          !value.lower().matches('.*signedurl.*') &&
          !isStorageSourcePath(value);
    }

    function isApprovedAvatarStoragePath(value) {
      return value is string &&
          (
            value.matches('^gs://seolleyeon-approved-avatars/users/[^/]+/avatar/[^/]+$') ||
            value.matches('^gs://seolleyeon-final-approved-avatars/users/[^/]+/avatar/[^/]+$')
          );
    }

    function avatarPublicMediaOk(avatar) {
      return avatar is map &&
          !avatar.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'qaEmbeddings',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls'
          ]) &&
          (!avatar.keys().hasAny(['approvedAvatarUrl']) ||
            avatar.approvedAvatarUrl == null ||
            avatar.approvedAvatarUrl == "" ||
            isSafePublicMediaUrl(avatar.approvedAvatarUrl)) &&
          (!avatar.keys().hasAny(['approvedAvatarStoragePath']) ||
            avatar.approvedAvatarStoragePath == null ||
            avatar.approvedAvatarStoragePath == "" ||
            isApprovedAvatarStoragePath(avatar.approvedAvatarStoragePath));
    }

    function onboardingPhotoUrlsOk(onboarding, data) {
      return !onboarding.keys().hasAny(['photoUrls']) ||
          (
            onboarding.photoUrls is list &&
            onboarding.photoUrls.size() <= 1 &&
            (
              onboarding.photoUrls.size() == 0 ||
              (
                data.avatar is map &&
                data.avatar.approvedAvatarUrl is string &&
                onboarding.photoUrls[0] == data.avatar.approvedAvatarUrl &&
                isSafePublicMediaUrl(onboarding.photoUrls[0])
              )
            )
          );
    }

    function onboardingPublicMediaOk(onboarding, data) {
      return onboarding is map &&
          !onboarding.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls'
          ]) &&
          onboardingPhotoUrlsOk(onboarding, data) &&
          (
            !onboarding.keys().hasAny(['avatarUrls']) ||
            (
              onboarding.avatarUrls is list &&
              onboarding.avatarUrls.size() <= 1 &&
              (
                onboarding.avatarUrls.size() == 0 ||
                isSafePublicMediaUrl(onboarding.avatarUrls[0])
              )
            )
          );
    }

    function avatarApprovalFieldsAbsent(data) {
      return !data.keys().hasAny(['avatar']) ||
          !(data.avatar is map) ||
          !data.avatar.keys().hasAny([
            'approvedAvatarUrl',
            'approvedAvatarStoragePath'
          ]);
    }

    function onboardingAvatarPhotoFieldsAbsent(data) {
      return !data.keys().hasAny(['onboarding']) ||
          !(data.onboarding is map) ||
          !data.onboarding.keys().hasAny([
            'avatarUrls',
            'photoUrls'
          ]);
    }

    function avatarApprovalFieldsUnchanged() {
      return (
          request.resource.data.keys().hasAny(['avatar']) &&
          resource.data.keys().hasAny(['avatar']) &&
          request.resource.data.avatar is map &&
          resource.data.avatar is map &&
          !request.resource.data.avatar.diff(resource.data.avatar).affectedKeys().hasAny([
            'approvedAvatarUrl',
            'approvedAvatarStoragePath'
          ])
        ) || (
          !(
            request.resource.data.keys().hasAny(['avatar']) &&
            request.resource.data.avatar is map &&
            request.resource.data.avatar.keys().hasAny([
              'approvedAvatarUrl',
              'approvedAvatarStoragePath'
            ])
          ) &&
          !(
            resource.data.keys().hasAny(['avatar']) &&
            resource.data.avatar is map &&
            resource.data.avatar.keys().hasAny([
              'approvedAvatarUrl',
              'approvedAvatarStoragePath'
            ])
          )
        );
    }

    function onboardingAvatarPhotoFieldsUnchanged() {
      return (
          request.resource.data.keys().hasAny(['onboarding']) &&
          resource.data.keys().hasAny(['onboarding']) &&
          request.resource.data.onboarding is map &&
          resource.data.onboarding is map &&
          !request.resource.data.onboarding.diff(resource.data.onboarding).affectedKeys().hasAny([
            'avatarUrls',
            'photoUrls'
          ])
        ) || (
          !(
            request.resource.data.keys().hasAny(['onboarding']) &&
            request.resource.data.onboarding is map &&
            request.resource.data.onboarding.keys().hasAny([
              'avatarUrls',
              'photoUrls'
            ])
          ) &&
          !(
            resource.data.keys().hasAny(['onboarding']) &&
            resource.data.onboarding is map &&
            resource.data.onboarding.keys().hasAny([
              'avatarUrls',
              'photoUrls'
            ])
          )
        );
    }

    function clientDoesNotCreateAvatarDisplayFields(data) {
      return avatarApprovalFieldsAbsent(data) &&
          onboardingAvatarPhotoFieldsAbsent(data);
    }

    function clientDoesNotModifyAvatarDisplayFields() {
      return avatarApprovalFieldsUnchanged() &&
          onboardingAvatarPhotoFieldsUnchanged();
    }

    function publicUserMediaOk(data) {
      return !data.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'sourcePhotoGcsUris',
            'chatRealPhoto',
            'chatRealPhotoUrl',
            'realPhotoUrl',
            'realProfilePhotoUrl',
            'gcsUri',
            'signedUrl',
            'signedUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls',
            'previewUrl',
            'previewUrls',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'qaEmbeddings'
          ]) &&
          (!data.keys().hasAny(['profileImageUrl']) ||
            data.profileImageUrl == null ||
            data.profileImageUrl == "" ||
            (
              data.avatar is map &&
              data.avatar.approvedAvatarUrl is string &&
              data.profileImageUrl == data.avatar.approvedAvatarUrl &&
              isSafePublicMediaUrl(data.profileImageUrl)
            )) &&
          (!data.keys().hasAny(['avatar']) ||
            avatarPublicMediaOk(data.avatar)) &&
          (!data.keys().hasAny(['onboarding']) ||
            onboardingPublicMediaOk(data.onboarding, data));
    }

    function chatRoomDoesNotPersistPrivateMedia(data) {
      return !data.keys().hasAny([
          'sourcePhotos',
          'sourcePhotoUrls',
          'sourcePhotoRefs',
          'sourcePhotoIds',
          'sourcePhotoGcsUri',
          'sourcePhotoGcsUris',
          'chatRealPhoto',
          'chatRealPhotoUrl',
          'realPhotoUrl',
          'realProfilePhotoUrl',
          'gcsUri',
          'gcsUris',
          'signedUrl',
          'signedUrls',
          'privatePhotoUrl',
          'privatePhotoUrls',
          'clipEmbedding',
          'clipEmbeddings',
          'vector',
          'faceEmbedding',
          'faceEmbeddings'
        ]);
    }

    match /users/{kakaoUserId} {
      allow get: if true;
      allow list: if true;

      // 연세 메일 학생 인증으로 최초 생성
      allow create: if publicUserMediaOk(request.resource.data) &&
          clientDoesNotCreateAvatarDisplayFields(request.resource.data) &&
          (
            (
              request.auth != null &&
              isYonseiEmail(request.auth.token.email) &&
              request.resource.data.keys().hasOnly([
                'kakaoUserId',
                'isStudentVerified',
                'studentEmail',
                'studentVerifiedAt',
                'verifiedAt'
              ]) &&
              (request.resource.data.kakaoUserId == null ||
                request.resource.data.kakaoUserId == kakaoUserId) &&
              request.resource.data.studentEmail is string &&
              isYonseiEmail(request.resource.data.studentEmail) &&
              request.resource.data.isStudentVerified == true
            ) ||
            (
              usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
              request.resource.data.keys().hasOnly([
                'kakaoUserId',
                'nickname',
                'profileImageUrl',
                'email',
                'createdAt',
                'lastLoginAt',
                'lastActivePlatform',
                'lastActivePlatformUpdatedAt',
                'onboarding',
                'onboardingUpdatedAt',
                'profileImageMode',
                'initialSetupComplete',
                'initialSetupCompletedAt',
                'onboardingCompletedAt',
                'idealType',
                'idealTypeUpdatedAt',
                'updatedAt',
                'hasSeenTutorial',
                'isStudentVerified',
                'studentEmail',
                'studentVerifiedAt',
                'verifiedAt',
                'preferenceVector'
              ])
            )
          );


      allow update: if publicUserMediaOk(request.resource.data) &&
          clientDoesNotModifyAvatarDisplayFields() && (
          (
            request.auth != null &&
            isYonseiEmail(request.auth.token.email) &&
            request.resource.data.studentEmail is string &&
            isYonseiEmail(request.resource.data.studentEmail) &&
            request.resource.data.isStudentVerified == true &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'isStudentVerified',
              'studentEmail',
              'studentVerifiedAt',
              'verifiedAt'
            ])
          ) || (
            isUserDocOwner(kakaoUserId) &&
            resource.data.isStudentVerified == true &&
            request.resource.data.isStudentVerified == true &&
            usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'profileImageMode',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'updatedAt'
            ])
          ) || (
            // 프로필 수정(온보딩 데이터 갱신) - 기존 규칙 유지 + 온보딩 편집 허용
            isUserDocOwner(kakaoUserId) &&
            (request.resource.data.kakaoUserId == null ||
              request.resource.data.kakaoUserId == kakaoUserId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'kakaoUserId',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'profileImageMode',
              'idealType',
              'idealTypeUpdatedAt',
              'updatedAt'
            ])
          )
        );

      // ---------------------------------------------------------------------
      // Device tokens
      // ---------------------------------------------------------------------
      match /deviceTokens/{token} {
        allow get, list: if true;

        allow create, update: if
          request.resource.data.userId is string &&
          request.resource.data.userId == kakaoUserId &&
          request.resource.data.token is string &&
          request.resource.data.token == token;

        allow delete: if true;
      }

      // ---------------------------------------------------------------------
      // In-app notifications
      // users/{kakaoUserId}/notifications/{notificationId}
      // ---------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.isRead is bool;

        allow update: if
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'isRead',
            'readAt'
          ]);

        allow delete: if true;
      }

      // ---------------------------------------------------------------------
      // Friends mirror
      // users/{kakaoUserId}/friends/{friendUid}
      // ---------------------------------------------------------------------
      match /friends/{friendUid} {
        allow get, list: if isVerifiedOwner(kakaoUserId);
        allow create, update, delete: if false;
      }

      // ---------------------------------------------------------------------
      // Contact blocked hashes (연락처 차단 - server-side callable로만 쓰기)
      // users/{kakaoUserId}/contactBlockedHashes/{phoneHash}
      // ---------------------------------------------------------------------
      match /contactBlockedHashes/{phoneHash} {
        allow get, list: if request.auth != null &&
          request.auth.uid == kakaoUserId;
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Backend-only private media and embeddings
    // -----------------------------------------------------------------------
    match /userPrivateMedia/{userId} {
      allow read, write: if false;
    }

    match /clipEmbeddings/{userId} {
      allow read, write: if false;
    }

    match /avatarJobs/{jobId} {
      allow read, write: if false;
    }

    match /avatarCandidates/{candidateId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Friend invites / friendships
    // -----------------------------------------------------------------------
    match /friendInvites/{inviteId} {
      allow get, list, create, update, delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // RecEvents (추천 학습용 이벤트 로그: open, like, nope 등)
    // -----------------------------------------------------------------------
    match /recEvents/{userId} {
      allow read, write: if true;

      match /events/{eventId} {
        allow read, write: if true;
      }
    }

    // -----------------------------------------------------------------------
    // Chat
    // -----------------------------------------------------------------------
    match /chat_rooms/{roomId} {
      allow read: if true;
      allow create, update: if chatRoomDoesNotPersistPrivateMedia(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if true;
        allow update: if true;

        allow delete: if false;
      }

      match /promises/{promiseId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }
    
        // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if true;
      allow write: if false;
    }


    // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Bamboo Forest (Community)
    // -----------------------------------------------------------------------
    match /bamboo_posts/{postId} {
      allow get, list: if true;

      allow create: if
        request.resource.data.postId is string &&
        request.resource.data.authorId is string &&
        request.resource.data.authorId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.tags is list &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.score7d == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if
        (
          resource.data.authorId == request.resource.data.authorId &&
          request.resource.data.isDeleted == true
        )
        ||
        (
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.tags == resource.data.tags
        );

      allow delete: if false;

      // ---------------------------------------------------------------------
      // Post likes
      // ---------------------------------------------------------------------
      match /likes/{userId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.userId is string &&
          request.resource.data.userId == userId;

        allow delete: if true;
        allow update: if false;
      }

      // ---------------------------------------------------------------------
      // Comments / Replies
      // ---------------------------------------------------------------------
      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if
          request.resource.data.commentId is string &&
          request.resource.data.authorId is string &&
          request.resource.data.authorId.size() > 0 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500 &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.isDeleted == false;

        allow update: if
          (
            resource.data.authorId == request.resource.data.authorId &&
            request.resource.data.isDeleted == true
          )
          ||
          (
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.content == resource.data.content &&
            request.resource.data.parentCommentId == resource.data.parentCommentId
          );

        allow delete: if false;

        // -------------------------------------------------------------------
        // Comment likes
        // -------------------------------------------------------------------
        match /likes/{userId} {
          allow get, list: if true;

          allow create: if
            request.resource.data.userId is string &&
            request.resource.data.userId == userId;

          allow delete: if true;
          allow update: if false;
        }
      }
    }

    // -----------------------------------------------------------------------
    // Blocks and Reports
    // -----------------------------------------------------------------------
    match /blocks/{viewerUid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /targets/{targetUid} {
        allow read: if true;
        allow create, update: if
          request.resource.data.fromUserId is string &&
          request.resource.data.toUserId is string &&
          request.resource.data.fromUserId == viewerUid &&
          request.resource.data.toUserId == targetUid;
        allow delete: if true;
      }
    }

    match /reports/{reportId} {
      allow create: if
        request.resource.data.reporterId is string &&
        request.resource.data.reportedId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.status is string;
      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /app_issue_reports/{reportId} {
      allow create: if
        request.resource.data.reporterId is string &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /app_inquiries/{inquiryId} {
      allow create: if
        request.resource.data.inquirerId is string &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    // -----------------------------------------------------------------------
    // User Private (전화번호 해시 등 민감 정보 - server callable로만 쓰기)
    // -----------------------------------------------------------------------
    match /userPrivate/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Phone Hash Index (역매칭 - server/admin only)
    // -----------------------------------------------------------------------
    match /phoneHashIndex/{phoneHash} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Contact Blocked Hash Index (연락처 차단 역인덱스 - server/admin only)
    // -----------------------------------------------------------------------
    match /contactBlockedHashIndex/{phoneHash} {
      allow read, write: if false;
      match /owners/{ownerUid} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------------
    // AI Profiles (더미 프로필 메타데이터: height 등, AI 취향 화면용)
    // -----------------------------------------------------------------------
    match /ai_profiles/{profileId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Model Recs (AI 추천 결과: rrf, clip, svd, knn - 서버에서 저장, 앱에서 읽기)
    // Kakao 로그인 시 request.auth가 null일 수 있어 read는 허용
    // -----------------------------------------------------------------------
    match /modelRecs/{userId}/daily/{dateKey}/sources/{algo} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Asks (무물: 1:1 질문)
    // -----------------------------------------------------------------------
    match /asks/{askId} {
      allow read: if true;

      allow create: if
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId.size() > 0 &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.status is string;

      allow update: if
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'readAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Interactions (like / nope / view / message)
    // -----------------------------------------------------------------------
    match /interactions/{interactionId} {
      allow read: if true;
      allow create: if
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId.size() > 0 &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.action is string &&
        request.resource.data.source is string &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'action', 'source',
          'metadata', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Matches (매치 성사 기록)
    // -----------------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if true;
      allow create: if
        request.resource.data.userIds is list &&
        request.resource.data.userIds.size() == 2 &&
        request.resource.data.matchType is string &&
        request.resource.data.status is string &&
        request.resource.data.keys().hasOnly([
          'userIds', 'matchType', 'matchedAt', 'status', 'chatRoomId'
        ]);
      allow update: if
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'unmatchedAt',
          'chatRoomId'
        ]);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Event 3인 팀 (초대·상태 - 쓰기는 Cloud Functions만, 읽기는 앱 동기화용)
    // -----------------------------------------------------------------------
    match /eventTeamSetups/{teamSetupId} {
      allow read: if true;
      allow write: if false;
    }

    match /eventTeamInvites/{inviteId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
