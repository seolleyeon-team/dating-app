rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isYonseiEmail(email) {
      return email != null && email.matches('^.+@yonsei\\.ac\\.kr$');
    }

    // -----------------------------------------------------------------------
    // Email-link token exchange (app stores Firestore token, web reads token)
    // -----------------------------------------------------------------------
    // A token document is NOT proof of identity. It only carries the
    // (kakaoUserId, email) pair from the app to the verification web page.
    // The former email-link custom-token callable was removed. Creation still
    // stays bound to the caller's Kakao-backed Firebase session so this lookup
    // document cannot be forged for another uid.
    match /emailLinkTokens/{token} {
      allow create: if request.auth != null &&
          request.resource.data.kakaoUserId is string &&
          request.auth.uid == request.resource.data.kakaoUserId &&
          request.resource.data.email is string &&
          isYonseiEmail(request.resource.data.email) &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.keys().hasOnly([
            'email',
            'kakaoUserId',
            'createdAt',
            'expiresAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'email',
            'kakaoUserId',
            'createdAt',
            'expiresAt'
          ]);

      // The verification page is unauthenticated when the email link opens it,
      // so it has to read the document it was handed. The document id is a
      // UUIDv4 that only ever travels inside the email link.
      allow get: if true;
      allow list: if false;

      allow update: if false;
      allow delete: if isSelf(resource.data.kakaoUserId);
}

        // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------
    // If users doc has no kakaoUserId field, rules evaluate it as null and allow profile edits.
    function usersDocKakaoIdOk(data, docKakaoId) {
      return data.kakaoUserId == null || data.kakaoUserId == docKakaoId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Community counters are client-written via FieldValue.increment(±1).
    // Without a ±1 gate anyone can set likeCount/score7d to an arbitrary rank.
    function intFieldUnchangedOrDeltaOne(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]) ||
        (
          request.resource.data[field] is int &&
          resource.data[field] is int &&
          (
            request.resource.data[field] == resource.data[field] + 1 ||
            request.resource.data[field] == resource.data[field] - 1
          )
        );
    }

    function nonNegativeIntField(field) {
      return !(field in request.resource.data) ||
        (
          request.resource.data[field] is int &&
          request.resource.data[field] >= 0
        );
    }

    function bambooPostCounterUpdateOk() {
      return intFieldUnchangedOrDeltaOne('likeCount') &&
        intFieldUnchangedOrDeltaOne('commentCount') &&
        intFieldUnchangedOrDeltaOne('score7d') &&
        nonNegativeIntField('likeCount') &&
        nonNegativeIntField('commentCount') &&
        nonNegativeIntField('score7d');
    }

    function bambooCommentCounterUpdateOk() {
      return intFieldUnchangedOrDeltaOne('likeCount') &&
        nonNegativeIntField('likeCount');
    }

    function isVerifiedOwner(kakaoUserId) {
      return isSelf(kakaoUserId);
    }

    // True when the caller holds a *verified* Yonsei mailbox. Used as the trust
    // anchor for student verification: the only thing that may set
    // isStudentVerified is a session Firebase itself proved owns the mailbox.
    function hasVerifiedYonseiEmail() {
      return request.auth != null &&
          request.auth.token.email is string &&
          request.auth.token.email_verified == true &&
          isYonseiEmail(request.auth.token.email);
    }

    function writesOwnStudentEmail(data) {
      return data.studentEmail is string &&
          data.studentEmail.lower() == request.auth.token.email.lower();
    }

    // A mailbox may be bound to a user document once. Rebinding is the profile
    // takeover primitive: isUserDocOwner() derives ownership from studentEmail,
    // so whoever can rewrite that field inherits the account.
    function studentEmailIsUnboundOrMine(existing) {
      return !existing.keys().hasAny(['studentEmail']) ||
          existing.studentEmail == null ||
          existing.studentEmail == "" ||
          existing.studentEmail.lower() == request.auth.token.email.lower();
    }

    function doesNotSelfAssertStudentVerification(data) {
      return (!data.keys().hasAny(['isStudentVerified']) ||
              data.isStudentVerified != true) &&
          (!data.keys().hasAny(['studentEmail']) ||
              data.studentEmail == null ||
              data.studentEmail == "");
    }

    function isUserDocOwner(kakaoUserId) {
      return request.auth != null &&
          (
            request.auth.uid == kakaoUserId ||
            (
              request.auth.token.email is string &&
              request.auth.token.email_verified == true &&
              isYonseiEmail(request.auth.token.email) &&
              resource.data.studentEmail is string &&
              isYonseiEmail(resource.data.studentEmail) &&
              request.auth.token.email == resource.data.studentEmail
            )
          );
    }

    function isStorageSourcePath(value) {
      return value is string &&
          (
            value.lower().matches('^https://storage\\.googleapis\\.com/.*') ||
            value.lower().matches('^https://firebasestorage\\.googleapis\\.com/.*')
          ) &&
          (
            value.lower().matches('.*/source/.*') ||
            value.lower().matches('.*%2fsource%2f.*')
          );
    }

    function isSafePublicMediaUrl(value) {
      return value is string &&
          !value.lower().matches('^gs://.*') &&
          !value.lower().matches('^gcs://.*') &&
          !value.lower().matches('.*seolleyeon-private-source-photos.*') &&
          !value.lower().matches('.*seolleyeon-final-private-source-photos.*') &&
          !value.lower().matches('.*seolleyeon-festival-private-source-photos.*') &&
          !value.lower().matches('.*seolleyeon-avatar-temp.*') &&
          !value.lower().matches('.*seolleyeon-final-avatar-temp.*') &&
          !value.lower().matches('.*seolleyeon-festival-avatar-temp.*') &&
          !value.lower().matches('.*seolleyeon-chat-profile-photos.*') &&
          !value.lower().matches('.*seolleyeon-final-chat-profile-photos.*') &&
          !value.lower().matches('.*seolleyeon-festival-chat-profile-photos.*') &&
          !value.lower().matches('.*x-goog-.*') &&
          !value.lower().matches('.*x-amz-.*') &&
          !value.lower().matches('.*googleaccessid.*') &&
          !value.lower().matches('.*signature=.*') &&
          !value.lower().matches('.*expires=.*') &&
          !value.lower().matches('.*awsaccesskeyid.*') &&
          !value.lower().matches('.*signedurl.*') &&
          !isStorageSourcePath(value);
    }

    function isApprovedAvatarStoragePath(value) {
      return value is string &&
          (
            value.matches('^gs://seolleyeon-final-approved-avatars/users/[^/]+/avatar/[^/]+$') ||
            value.matches('^gs://seolleyeon-festival-approved-avatars/users/[^/]+/avatar/[^/]+$')
          );
    }

    function avatarPublicMediaOk(avatar) {
      return avatar is map &&
          !avatar.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'qaEmbeddings',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls'
          ]) &&
          (!avatar.keys().hasAny(['approvedAvatarUrl']) ||
            avatar.approvedAvatarUrl == null ||
            avatar.approvedAvatarUrl == "" ||
            isSafePublicMediaUrl(avatar.approvedAvatarUrl)) &&
          (!avatar.keys().hasAny(['approvedAvatarStoragePath']) ||
            avatar.approvedAvatarStoragePath == null ||
            avatar.approvedAvatarStoragePath == "" ||
            isApprovedAvatarStoragePath(avatar.approvedAvatarStoragePath));
    }

    function onboardingPhotoUrlsOk(onboarding, data) {
      return !onboarding.keys().hasAny(['photoUrls']) ||
          (
            onboarding.photoUrls is list &&
            onboarding.photoUrls.size() <= 1 &&
            (
              onboarding.photoUrls.size() == 0 ||
              (
                data.avatar is map &&
                data.avatar.approvedAvatarUrl is string &&
                onboarding.photoUrls[0] == data.avatar.approvedAvatarUrl &&
                isSafePublicMediaUrl(onboarding.photoUrls[0])
              )
            )
          );
    }

    function onboardingPublicMediaOk(onboarding, data) {
      return onboarding is map &&
          !onboarding.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls'
          ]) &&
          onboardingPhotoUrlsOk(onboarding, data) &&
          (
            !onboarding.keys().hasAny(['avatarUrls']) ||
            (
              onboarding.avatarUrls is list &&
              onboarding.avatarUrls.size() <= 1 &&
              (
                onboarding.avatarUrls.size() == 0 ||
                isSafePublicMediaUrl(onboarding.avatarUrls[0])
              )
            )
          );
    }

    function avatarApprovalFieldsAbsent(data) {
      return !data.keys().hasAny(['avatar']) ||
          !(data.avatar is map) ||
          !data.avatar.keys().hasAny([
            'approvedAvatarUrl',
            'approvedAvatarStoragePath'
          ]);
    }

    function onboardingAvatarPhotoFieldsAbsent(data) {
      let onboarding = data.get('onboarding', {});
      return onboarding is map &&
          !onboarding.keys().hasAny([
            'avatarUrls',
            'photoUrls',
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings'
          ]);
    }

    function avatarApprovalFieldsUnchanged() {
      return (
          request.resource.data.keys().hasAny(['avatar']) &&
          resource.data.keys().hasAny(['avatar']) &&
          request.resource.data.avatar is map &&
          resource.data.avatar is map &&
          !request.resource.data.avatar.diff(resource.data.avatar).affectedKeys().hasAny([
            'approvedAvatarUrl',
            'approvedAvatarStoragePath'
          ])
        ) || (
          !(
            request.resource.data.keys().hasAny(['avatar']) &&
            request.resource.data.avatar is map &&
            request.resource.data.avatar.keys().hasAny([
              'approvedAvatarUrl',
              'approvedAvatarStoragePath'
            ])
          ) &&
          !(
            resource.data.keys().hasAny(['avatar']) &&
            resource.data.avatar is map &&
            resource.data.avatar.keys().hasAny([
              'approvedAvatarUrl',
              'approvedAvatarStoragePath'
            ])
          )
        );
    }

    function onboardingAvatarPhotoFieldsUnchanged() {
      let after = request.resource.data.get('onboarding', {});
      let before = resource.data.get('onboarding', {});
      return after is map && before is map &&
          !after.diff(before).affectedKeys().hasAny([
            'avatarUrls',
            'photoUrls',
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'gcsUri',
            'signedUrl',
            'signedUrls',
            'previewUrl',
            'previewUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings'
          ]);
    }

    function clientDoesNotCreateAvatarDisplayFields(data) {
      return avatarApprovalFieldsAbsent(data) &&
          onboardingAvatarPhotoFieldsAbsent(data);
    }

    function clientDoesNotModifyAvatarDisplayFields() {
      return avatarApprovalFieldsUnchanged() &&
          onboardingAvatarPhotoFieldsUnchanged();
    }

    function publicUserMediaOk(data) {
      return !data.keys().hasAny([
            'sourcePhotos',
            'sourcePhotoUrls',
            'sourcePhotoRefs',
            'sourcePhotoIds',
            'sourcePhotoGcsUri',
            'sourcePhotoGcsUris',
            'chatRealPhoto',
            'chatRealPhotoUrl',
            'realPhotoUrl',
            'realProfilePhotoUrl',
            'gcsUri',
            'signedUrl',
            'signedUrls',
            'candidatePreviewUrl',
            'candidatePreviewUrls',
            'previewUrl',
            'previewUrls',
            'clipEmbedding',
            'clipEmbeddings',
            'vector',
            'faceEmbedding',
            'faceEmbeddings',
            'qaEmbeddings'
          ]) &&
          (!data.keys().hasAny(['profileImageUrl']) ||
            data.profileImageUrl == null ||
            data.profileImageUrl == "" ||
            (
              data.avatar is map &&
              data.avatar.approvedAvatarUrl is string &&
              data.profileImageUrl == data.avatar.approvedAvatarUrl &&
              isSafePublicMediaUrl(data.profileImageUrl)
            )) &&
          (!data.keys().hasAny(['avatar']) ||
            avatarPublicMediaOk(data.avatar)) &&
          (!data.keys().hasAny(['onboarding']) ||
            onboardingPublicMediaOk(data.onboarding, data));
    }

    function chatRoomParticipantIds(data) {
      return data.participantIds is list ? data.participantIds : [];
    }

    function isChatRoomParticipant() {
      return isSignedIn() && request.auth.uid in chatRoomParticipantIds(resource.data);
    }

    function isChatRoomParticipantAfter() {
      return isSignedIn() && request.auth.uid in chatRoomParticipantIds(request.resource.data);
    }

    function chatRoomParticipantIdsUnchanged() {
      return request.resource.data.participantIds == resource.data.participantIds;
    }

    function isExistingChatRoomParticipant(roomId) {
      return isSignedIn() &&
          request.auth.uid in chatRoomParticipantIds(
            get(/databases/$(database)/documents/chat_rooms/$(roomId)).data
          );
    }

    function isParticipantMessageAuthor(roomId) {
      return isExistingChatRoomParticipant(roomId) &&
          request.resource.data.senderId is string &&
          request.resource.data.senderId == request.auth.uid;
    }

    // Participants mark messages read by appending themselves to readBy.
    // Anything else — especially rewriting someone else's text — is denied.
    function onlyMessageReadReceiptUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readBy', 'updatedAt']);
    }

    // Promise cards are updated in-place (request → confirmed / rejected /
    // cancelled / edited). Free-form chat text must never enter this path, so
    // the *existing* message must already be a promise_* type.
    function isExistingPromiseMessage() {
      return resource.data.keys().hasAny(['type']) &&
          resource.data.type is string &&
          resource.data.type.matches('promise_.*');
    }

    function onlyPromiseMessageLifecycleUpdate() {
      return isExistingPromiseMessage() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'text',
            'dateTime',
            'place',
            'placeCategory',
            'placeId',
            'placeAddress',
            'placeLat',
            'placeLng',
            'placeThumbnailUrl',
            'status',
            'readBy',
            'updatedAt',
            'isEdited',
            'editedAt'
          ]) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.type is string &&
          request.resource.data.type.matches('promise_.*');
    }

    function canUpdateChatMessage(roomId) {
      return isExistingChatRoomParticipant(roomId) &&
          (onlyMessageReadReceiptUpdate() || onlyPromiseMessageLifecycleUpdate());
    }

    function isAskParticipant(data) {
      return isSignedIn() &&
          (
            data.fromUserId == request.auth.uid ||
            data.toUserId == request.auth.uid
          );
    }

    function isInteractionParticipant(data) {
      return isSignedIn() &&
          (
            data.fromUserId == request.auth.uid ||
            data.toUserId == request.auth.uid
          );
    }

    function isMatchParticipant(data) {
      return isSignedIn() &&
          data.userIds is list &&
          request.auth.uid in data.userIds;
    }

    function matchStatusOnlyMovesToUnmatched() {
      return resource.data.status == 'active' &&
          request.resource.data.status == 'unmatched' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'unmatchedAt'
          ]);
    }

    function isEventTeamSetupParticipant(data) {
      return isSignedIn() &&
          (
            data.leaderUserId == request.auth.uid ||
            (
              data.acceptedUserIds is list &&
              request.auth.uid in data.acceptedUserIds
            ) ||
            (
              data.pendingInviteeIds is list &&
              request.auth.uid in data.pendingInviteeIds
            )
          );
    }

    function isEventTeamInviteParticipant(data) {
      return isSignedIn() &&
          (
            data.inviterUserId == request.auth.uid ||
            data.inviteeUserId == request.auth.uid
          );
    }

    function isEventTeamMatchParticipant(data) {
      return isSignedIn() &&
          data.participantUids is list &&
          request.auth.uid in data.participantUids;
    }

    function chatRoomDoesNotPersistPrivateMedia(data) {
      return !data.keys().hasAny([
          'sourcePhotos',
          'sourcePhotoUrls',
          'sourcePhotoRefs',
          'sourcePhotoIds',
          'sourcePhotoGcsUri',
          'sourcePhotoGcsUris',
          'chatRealPhoto',
          'chatRealPhotoUrl',
          'realPhotoUrl',
          'realProfilePhotoUrl',
          'gcsUri',
          'gcsUris',
          'signedUrl',
          'signedUrls',
          'privatePhotoUrl',
          'privatePhotoUrls',
          'clipEmbedding',
          'clipEmbeddings',
          'vector',
          'faceEmbedding',
          'faceEmbeddings'
        ]);
    }

    match /users/{kakaoUserId} {
      // PRIVATE_OWNER_ONLY (+ Admin SDK). Cross-user reads must use
      // publicProfiles/{uid}. Collection list stays denied.
      allow get: if isSelf(kakaoUserId);
      allow list: if false;

      // Initial creation through Yonsei email student verification
      allow create: if onboardingAvatarPhotoFieldsAbsent(request.resource.data) &&
          (
            (
              hasVerifiedYonseiEmail() &&
              writesOwnStudentEmail(request.resource.data) &&
              request.resource.data.keys().hasOnly([
                'kakaoUserId',
                'isStudentVerified',
                'studentEmail',
                'studentVerifiedAt',
                'verifiedAt'
              ]) &&
              (request.resource.data.kakaoUserId == null ||
                request.resource.data.kakaoUserId == kakaoUserId) &&
              request.resource.data.studentEmail is string &&
              isYonseiEmail(request.resource.data.studentEmail) &&
              request.resource.data.isStudentVerified == true
            ) ||
            (
              // Kakao-bridged app session creating its own shell document.
              // It may not assert student verification for itself.
              isSelf(kakaoUserId) &&
              doesNotSelfAssertStudentVerification(request.resource.data) &&
              usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
              (!request.resource.data.keys().hasAny(['profileImageUrl']) ||
                request.resource.data.profileImageUrl == null ||
                request.resource.data.profileImageUrl == "") &&
              request.resource.data.keys().hasOnly([
                'kakaoUserId',
                'nickname',
                'profileImageUrl',
                'email',
                'createdAt',
                'lastLoginAt',
                'lastActivePlatform',
                'lastActivePlatformUpdatedAt',
                'onboarding',
                'onboardingUpdatedAt',
                'profileImageMode',
                'initialSetupComplete',
                'initialSetupCompletedAt',
                'onboardingCompletedAt',
                'idealType',
                'idealTypeUpdatedAt',
                'updatedAt',
                'hasSeenTutorial',
                'isStudentVerified',
                'studentEmail',
                'studentVerifiedAt',
                'verifiedAt',
                'legalConsents',
                'privacySettings',
                'privacySettingsUpdatedAt',
                'notificationSettings',
                'notificationSettingsUpdatedAt',
                'preferenceVector'
              ])
            )
          );


      allow update: if onboardingAvatarPhotoFieldsUnchanged() && (
          (
            // Student verification write, performed by the email-link session
            // (public/index.html, or the in-app link handler). The mailbox must
            // be Firebase-verified, must be the one being written, and must not
            // already belong to someone else.
            hasVerifiedYonseiEmail() &&
            writesOwnStudentEmail(request.resource.data) &&
            studentEmailIsUnboundOrMine(resource.data) &&
            request.resource.data.isStudentVerified == true &&
            // affectedKeys (not changedKeys): newly added fields must also be
            // constrained — changedKeys ignores keys that did not exist before.
request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'isStudentVerified',
              'studentEmail',
              'studentVerifiedAt',
              'verifiedAt'
            ])
          ) || (
            isUserDocOwner(kakaoUserId) &&
            resource.data.isStudentVerified == true &&
            request.resource.data.isStudentVerified == true &&
            usersDocKakaoIdOk(request.resource.data, kakaoUserId) &&
            // Client-writable allowlist only. Moderation / withdrawal /
            // verification timestamps / loginDisabled are server-only.
            // Use affectedKeys so forging brand-new protected fields is denied.
request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'email',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'profileImageMode',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'profileVisible',
              'lastLoginAt',
              'hasSeenTutorial',
              'updatedAt'
            ])
          ) || (
            // Profile edit (onboarding data update) - keep existing rules and allow onboarding edits
            isUserDocOwner(kakaoUserId) &&
            (request.resource.data.kakaoUserId == null ||
              request.resource.data.kakaoUserId == kakaoUserId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'kakaoUserId',
              'nickname',
              'email',
              'lastActivePlatform',
              'lastActivePlatformUpdatedAt',
              'onboarding',
              'onboardingUpdatedAt',
              'profileImageMode',
              'idealType',
              'idealTypeUpdatedAt',
              'legalConsents',
              'privacySettings',
              'privacySettingsUpdatedAt',
              'notificationSettings',
              'notificationSettingsUpdatedAt',
              'preferenceVector',
              'profileVisible',
              'lastLoginAt',
              'hasSeenTutorial',
              'initialSetupComplete',
              'initialSetupCompletedAt',
              'onboardingCompletedAt',

              'updatedAt'
            ])
          )
        );

      // ---------------------------------------------------------------------
      // Device tokens
      // ---------------------------------------------------------------------
      // 이전: get/list/delete 가 `if true`, create/update 에 request.auth 조건
      // 없음. FCM 토큰이 전역 공개였고 남의 uid 아래에 자기 토큰을 등록할 수
      // 있었다. shared/notify.ts 의 fetchUserTokens 는 이 문서 ID 를 그대로
      // 수신자로 쓰기 때문에, 공격자가 피해자의 푸시(채팅 원문 포함)를
      // 받아볼 수 있었고 남의 토큰을 지워 푸시를 막을 수도 있었다.
      match /deviceTokens/{token} {
        allow get, list: if isSelf(kakaoUserId);

        allow create, update: if isSelf(kakaoUserId) &&
          request.resource.data.userId is string &&
          request.resource.data.userId == kakaoUserId &&
          request.resource.data.token is string &&
          request.resource.data.token == token;

        allow delete: if isSelf(kakaoUserId);
      }

      // ---------------------------------------------------------------------
      // In-app notifications
      // users/{kakaoUserId}/notifications/{notificationId}
      // ---------------------------------------------------------------------
      // 이전: get/list/delete 가 `if true`, create 에 request.auth 조건 없음.
      // 누구나 남의 알림함을 읽고 지울 수 있었고 임의 사용자에게 알림을
      // 꽂아넣을 수 있었다(스팸·피싱 문구 삽입).
      // 서버는 Admin SDK 로 쓰기 때문에 규칙을 우회하므로 영향이 없다.
      match /notifications/{notificationId} {
        allow get, list: if isSelf(kakaoUserId);

        allow create: if false;

        allow update: if isSelf(kakaoUserId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'readAt'
          ]);

        allow delete: if false;
      }

      // ---------------------------------------------------------------------
      // Friends mirror
      // users/{kakaoUserId}/friends/{friendUid}
      // ---------------------------------------------------------------------
      match /friends/{friendUid} {
        allow get, list: if isVerifiedOwner(kakaoUserId);
        allow create, update, delete: if false;
      }

      // ---------------------------------------------------------------------
      // Contact blocked hashes (contact blocking - writes only through server-side callable)
      // users/{kakaoUserId}/contactBlockedHashes/{phoneHash}
      // ---------------------------------------------------------------------
      match /contactBlockedHashes/{phoneHash} {
        allow get, list: if request.auth != null &&
          request.auth.uid == kakaoUserId;
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Backend-only private media and embeddings
    // -----------------------------------------------------------------------
    match /userPrivateMedia/{userId} {
      allow read, write: if false;
    }

    match /clipEmbeddings/{userId} {
      allow read, write: if false;
    }

    match /avatarJobs/{jobId} {
      allow read, write: if false;
    }

    match /avatarCandidates/{candidateId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Friend invites / friendships
    // -----------------------------------------------------------------------
    match /friendInvites/{inviteId} {
      allow get, list, create, update, delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // RecEvents (recommendation training event log: open, like, nope, etc.)
    // Clients may append their own events, but must not rewrite history —
    // forged updates would let someone manufacture mutual likes after the fact.
    // -----------------------------------------------------------------------
    function isAllowedRecEventType(eventType) {
      return eventType in [
        'impression',
        'open',
        'detail_open',
        'view',
        'like',
        'nope',
        'super_like',
        'swipe_right',
        'block',
        'report'
      ];
    }

    function isValidRecEventCreate(userId) {
      return request.resource.data.userId is string &&
          request.resource.data.userId == userId &&
          request.resource.data.type is string &&
          isAllowedRecEventType(request.resource.data.type) &&
          request.resource.data.eventType is string &&
          request.resource.data.eventType == request.resource.data.type &&
          request.resource.data.targetUserId is string &&
          request.resource.data.targetUserId.size() > 0 &&
          request.resource.data.targetUserId != userId &&
          request.resource.data.keys().hasOnly([
            'userId',
            'targetType',
            'targetId',
            'targetUserId',
            'candidateUserId',
            'type',
            'eventType',
            'surface',
            'source',
            'cardVariant',
            'eventTime',
            'createdAt',
            'exposureId',
            'sessionId',
            'dateKey',
            'context',
            'schemaVersion'
          ]) &&
          (
            !('schemaVersion' in request.resource.data) ||
            (
              request.resource.data.schemaVersion is int &&
              request.resource.data.schemaVersion == 1
            )
          );
    }

    match /recEvents/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && isValidRecEventCreate(userId);
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Chat
    //
    // 블라인드 취향 미팅 채팅방(roomType이 blind_meeting_*)은 서버가 멤버십과
    // 읽기 전용 여부를 관리하므로 클라이언트 쓰기를 별도로 제한한다.
    // -----------------------------------------------------------------------
    function blindMeetingRoomTypes() {
      return ['blind_meeting_group', 'blind_meeting_direct'];
    }

    function isBlindMeetingRoomData(data) {
      return data != null &&
          data.get('roomType', null) in blindMeetingRoomTypes();
    }

    function seasonMeetingRoomTypes() {
      return ['season_meeting_group', 'event_season_meeting_group', 'three_vs_three_group'];
    }

    function seasonMeetingRoomGroupKinds() {
      return ['group', 'three_vs_three', 'event_team_group'];
    }

    function isSeasonMeetingRoomData(data) {
      return data != null && (
          data.get('roomType', null) in seasonMeetingRoomTypes() ||
          (
            data.get('eventType', null) == 'season_meeting' &&
            data.get('type', null) in seasonMeetingRoomGroupKinds()
          ) ||
          (
            data.get('type', null) in seasonMeetingRoomGroupKinds() &&
            (
              data.get('threeVsThreeMatchId', null) is string ||
              data.get('seasonMeetingMatchId', null) is string ||
              data.get('eventThreeVsThreeMatchId', null) is string
            )
          )
        );
    }

    // 클라이언트가 만드는 방은 미팅/매치 연결 필드를 가질 수 없다.
    // roomType/type 분류를 우회한 위조(예: type:'direct' + threeVsThreeMatchId,
    // 임의 meetingId 부착)를 create 시점에 차단한다. 시즌/블라인드 방은
    // 서버(Admin SDK)만 생성하므로 규칙의 영향을 받지 않는다.
    function chatRoomCreateHasNoMeetingLinkage(data) {
      return !data.keys().hasAny([
        'meetingId',
        'matchId',
        'threeVsThreeMatchId',
        'seasonMeetingMatchId',
        'eventThreeVsThreeMatchId',
        'eventType'
      ]);
    }

    function seasonMeetingRoomMutableOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessage',
        'lastMessageAt',
        'updatedAt',
        'activePromise',
        'photoBlurUnlocked',
        'photoBlurUnlockedAt',
        'photoBlurUnlockedBy'
      ]);
    }

    function blindRoomData(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
    }

    function isRoomParticipant(roomId) {
      return request.auth != null &&
          request.auth.uid in blindRoomData(roomId).participantIds;
    }

    // 이전: chat_rooms 와 messages 모두 `allow read: if true` 였다. 인증 없이
    // 전체 사용자의 채팅 원문을 읽을 수 있었다. 또 블라인드 미팅이 아닌 방은
    // create/update 에 조건이 사실상 없어서 누구나 방을 만들고 남의 이름으로
    // 메시지를 넣을 수 있었다.
    //
    // 참가자 모델: chat_rooms 문서의 participantIds 배열.
    // 목록 조회는 where('participantIds' arrayContains uid) 로 하므로
    // 문서 단위 규칙과 맞는다 (chat_service.dart:61 / :69).
    //
    // 블라인드 미팅 방의 기존 조건은 그대로 유지한다. 아래 변경은 모든
    // roomType 에 참가자 게이트를 추가하는 것이고, 블라인드 전용 추가 조건은
    // 손대지 않았다. 회귀는 blind_meeting_rules.test.js 로 확인해야 한다.
    match /chat_rooms/{roomId} {
      allow read: if isChatRoomParticipant();
      allow create: if isChatRoomParticipantAfter() &&
        !isBlindMeetingRoomData(request.resource.data) &&
        !isSeasonMeetingRoomData(request.resource.data) &&
        chatRoomCreateHasNoMeetingLinkage(request.resource.data) &&
        chatRoomDoesNotPersistPrivateMedia(request.resource.data);
      // participantIds is immutable after create — changing it would let a
      // participant add a third party who can then read the full history.
      allow update: if isChatRoomParticipant() &&
        isChatRoomParticipantAfter() &&
        chatRoomParticipantIdsUnchanged() &&
        chatRoomDoesNotPersistPrivateMedia(request.resource.data) &&
        (!isBlindMeetingRoomData(resource.data) || (
          resource.data.writable == true &&
          request.resource.data.roomType == resource.data.roomType &&
          request.resource.data.writable == resource.data.writable &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.meetingId == resource.data.meetingId
        )) &&
        ((!isSeasonMeetingRoomData(resource.data) &&
          !isSeasonMeetingRoomData(request.resource.data)) ||
          (isSeasonMeetingRoomData(resource.data) &&
            isSeasonMeetingRoomData(request.resource.data) &&
            seasonMeetingRoomMutableOnly()));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isExistingChatRoomParticipant(roomId);
        allow create: if isParticipantMessageAuthor(roomId) &&
          (!isBlindMeetingRoomData(blindRoomData(roomId)) || (
            blindRoomData(roomId).writable == true &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 1000
          ));
        allow update: if canUpdateChatMessage(roomId) &&
          (!isBlindMeetingRoomData(blindRoomData(roomId)) || (
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.text == resource.data.text
          ));
        allow delete: if false;
      }

      match /promises/{promiseId} {
        allow read: if isExistingChatRoomParticipant(roomId);
        allow create, update: if isExistingChatRoomParticipant(roomId) &&
          (!isBlindMeetingRoomData(blindRoomData(roomId)) ||
            blindRoomData(roomId).writable == true);
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // 3:3 블라인드 취향 미팅
    //
    //  - 비공개 미팅 DNA는 본인만 읽을 수 있고 클라이언트 쓰기는 전면 금지
    //  - 미팅 상태·팀 배열·결제·참석 상태는 서버(Cloud Functions)만 변경
    //  - 내부 매칭 점수는 클라이언트에서 읽을 수 없음
    //  - 후속 선택은 본인 문서만 읽기 가능, 상호 선택 판정은 서버 전용
    // -----------------------------------------------------------------------
    function isBlindOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function blindMeetingData(meetingId) {
      return get(/databases/$(database)/documents/blindMeetings/$(meetingId)).data;
    }

    function isBlindMeetingParticipant(meetingId) {
      return request.auth != null &&
          request.auth.uid in blindMeetingData(meetingId).participantIds;
    }

    // 비공개 미팅 DNA: 본인 읽기만, 쓰기는 callable(submitBlindMeetingApplication)만
    match /blindMeetingDna/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 신청 상태: 본인 읽기만
    match /blindMeetingApplications/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetings/{meetingId} {
      // 자신이 참가한 미팅만 조회 가능
      allow get, list: if request.auth != null &&
          request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      // 참가자 상태: 본인 문서만 읽기, 쓰기는 서버만
      match /participants/{userId} {
        allow get: if isBlindOwner(userId) ||
            isBlindMeetingParticipant(meetingId);
        allow list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 공개 프로필 스냅샷 (얼굴 사진·비공개 DNA 없음)
      match /publicProfiles/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      // 내부 매칭 점수: 서버 전용
      match /matchingResult/{docId} {
        allow read, write: if false;
      }

      // 후속 선택: 자신의 선택만 읽기, 쓰기는 callable만
      match /followUpChoices/{chooserUid} {
        allow get: if isBlindOwner(chooserUid);
        allow list: if false;
        allow create, update, delete: if false;
      }

      // 상호 선택 결과: callable(getBlindMeetingMutualMatches)로만 조회
      match /mutualMatches/{pairId} {
        allow read, write: if false;
      }

      match /feedback/{userId} {
        allow get: if isBlindOwner(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /scheduleVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }

      match /fivePersonVotes/{userId} {
        allow get, list: if isBlindMeetingParticipant(meetingId);
        allow create, update, delete: if false;
      }
    }

    // 대체 참가 제안: 제안받은 본인만 조회
    match /blindMeetingReplacementOffers/{offerId} {
      allow get: if request.auth != null &&
          request.auth.uid == resource.data.candidateUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 참여 제한 / 통계: 본인 읽기만
    match /blindMeetingRestrictions/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /blindMeetingStats/{userId} {
      allow get: if isBlindOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;

      match /noShows/{meetingId} {
        allow read, write: if false;
      }
    }

    match /blindMeetingHistory/{userId} {
      allow read, write: if false;
      match /metUsers/{otherUid} {
        allow read, write: if false;
      }
    }

    // 결제/환불, 안전 flag, 운영 검토, 알림 발송 로그: 서버 전용
    match /blindMeetingDeposits/{depositId} {
      allow read, write: if false;
    }

    match /blindMeetingSafetyFlags/{meetingId} {
      allow read, write: if false;
    }

    match /blindMeetingOpsReviews/{reviewId} {
      allow read, write: if false;
    }

    match /notificationDispatchLog/{dispatchKey} {
      allow read, write: if false;
    }

    // 운영 설정(보증금 금액 등)은 읽기 전용으로 공개
    match /blindMeetingConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // 추천 정책의 rollout activation 상태. 서버(Admin SDK)만 쓴다.
    // 클라이언트는 생활권 prerequisite 를 안내로 보여줄지 차단으로 보여줄지
    // 판단하기 위해 읽기만 한다. 클라이언트가 activation 을 바꿀 수 없다.
    match /recommendationConfig/{docId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    // Analytics: 개인정보 없는 이벤트만 append. 조회는 서버/운영 전용.
    match /blindMeetingAnalytics/{eventId} {
      allow create: if
          request.resource.data.event is string &&
          request.resource.data.event.size() > 0 &&
          request.resource.data.event.matches('^blind_meeting_[a-z0-9_]+$') &&
          request.resource.data.params is map &&
          !('nickname' in request.resource.data.params) &&
          !('interests' in request.resource.data.params) &&
          !('userId' in request.resource.data.params) &&
          !('studentEmail' in request.resource.data.params);
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // 3:3 미팅 아이스브레이킹 룰렛 (시즌 미팅 / 블라인드 취향 미팅 전용)
    //
    //  - 15분 반복 알림 상태는 서버(Cloud Functions)만 만들고 바꾼다
    //  - 참가자는 자신의 문서만 읽는다 (다른 참가자의 알림 설정은 비공개)
    //  - "이번 미팅 알림 끄기"는 callable(meetingIcebreakerAction)만 처리한다
    // -----------------------------------------------------------------------
    match /meetingIcebreakerSessions/{sessionId} {
      // 세션 메타(원본 미팅 참조)는 클라이언트가 직접 읽지 않는다.
      allow read: if false;
      allow create, update, delete: if false;

      match /promptParticipants/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        // isActive / nextPromptAt / promptSequence / stopReason 는 서버 전용
        allow create, update, delete: if false;
      }
    }

    // 운영 설정(알림 주기, 최대 지속 시간, feature flag)은 읽기 전용으로 공개
    match /meetingIcebreakerConfig/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Analytics: 개인정보와 폭탄 숨겨진 시간이 없는 이벤트만 append.
    match /meetingIcebreakerAnalytics/{eventId} {
      allow create: if
          request.resource.data.event is string &&
          request.resource.data.event.size() > 0 &&
          request.resource.data.event.matches('^(meeting_icebreaker|meeting_roulette|meeting_game|bomb_timer)_[a-z0-9_]+$') &&
          request.resource.data.params is map &&
          !('nickname' in request.resource.data.params) &&
          !('userId' in request.resource.data.params) &&
          !('participantIds' in request.resource.data.params) &&
          !('place' in request.resource.data.params) &&
          !('hiddenSeconds' in request.resource.data.params) &&
          !('bombSeconds' in request.resource.data.params) &&
          !('fcmToken' in request.resource.data.params);
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Promise place catalog
    // -----------------------------------------------------------------------
    match /place_catalog_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /place_catalog_items/{placeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Bamboo Forest (Community)
    // -----------------------------------------------------------------------
    // 이전: create 에 request.auth 조건이 없어서 authorId 를 위조해 남의
    // 이름으로 글을 쓸 수 있었고, update 2번째 분기가 카운터를 보호하지 않아
    // likeCount / commentCount / score7d 를 임의 값으로 바꿀 수 있었다
    // (인기 순위 조작).
    match /bamboo_posts/{postId} {
      allow get, list: if isSignedIn();

      allow create: if
        isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.authorId is string &&
        request.resource.data.authorId.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.tags is list &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.score7d == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if
        (
          resource.data.authorId == request.auth.uid &&
          resource.data.authorId == request.resource.data.authorId &&
          request.resource.data.isDeleted == true
        )
        ||
        (
          isSignedIn() &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.tags == resource.data.tags &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount', 'commentCount', 'score7d', 'updatedAt'
          ]) &&
          bambooPostCounterUpdateOk()
        );

      allow delete: if false;

      // ---------------------------------------------------------------------
      // Post likes
      // ---------------------------------------------------------------------
      // 이전: 익명 read, create 에 auth 조건 없음, delete 가 `if true` 여서
      // 남의 좋아요를 취소할 수 있었다.
      match /likes/{userId} {
        allow get, list: if isSignedIn();

        allow create: if
          isSelf(userId) &&
          request.resource.data.userId is string &&
          request.resource.data.userId == request.auth.uid;

        allow delete: if isSelf(userId);
        allow update: if false;
      }

      // ---------------------------------------------------------------------
      // Comments / Replies
      // ---------------------------------------------------------------------
      match /comments/{commentId} {
        allow get, list: if isSignedIn();

        allow create: if
          isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.commentId is string &&
          request.resource.data.authorId is string &&
          request.resource.data.authorId.size() > 0 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500 &&
          request.resource.data.likeCount == 0 &&
          request.resource.data.isDeleted == false;

        allow update: if
          (
            resource.data.authorId == request.auth.uid &&
            resource.data.authorId == request.resource.data.authorId &&
            request.resource.data.isDeleted == true
          )
          ||
          (
            isSignedIn() &&
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.content == resource.data.content &&
            request.resource.data.parentCommentId == resource.data.parentCommentId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount', 'updatedAt'
            ]) &&
            bambooCommentCounterUpdateOk()
          );

        allow delete: if false;

        // -------------------------------------------------------------------
        // Comment likes
        // -------------------------------------------------------------------
        match /likes/{userId} {
          allow get, list: if isSignedIn();

          allow create: if
            isSelf(userId) &&
            request.resource.data.userId is string &&
            request.resource.data.userId == request.auth.uid;

          allow delete: if isSelf(userId);
          allow update: if false;
        }
      }
    }

    // -----------------------------------------------------------------------
    // Blocks and Reports
    // -----------------------------------------------------------------------
    // Blocks are written only by the server (reportAndBlockUser,
    // syncContactBlocks). A block must exist in both directions, and a client
    // can only ever write its own side, so client writes are denied here.
    // Reads stay open to the owner for defensive filtering in the feed.
    match /blocks/{viewerUid} {
      allow read: if isSelf(viewerUid);
      allow create, update: if false;
      allow delete: if isSelf(viewerUid);

      match /targets/{targetUid} {
        allow read: if isSelf(viewerUid);
        allow create, update: if false;
        allow delete: if isSelf(viewerUid);
      }
    }

    // User reports go through the reportAndBlockUser callable so that the
    // report and both block directions are written atomically.
    match /reports/{reportId} {
      allow create: if false;
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 이전: read/update/delete 가 모두 `if true`.
    // 본인이 낸 문의는 본인이 볼 수 있어야 하므로 소유자 스코프 read 만 남긴다.
    // 상태 변경과 삭제는 서버 전용이다.
    match /app_issue_reports/{reportId} {
      allow create: if
        isSignedIn() &&
        request.resource.data.reporterId is string &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 이전: read/update/delete 가 모두 `if true`.
    match /app_inquiries/{inquiryId} {
      allow create: if
        isSignedIn() &&
        request.resource.data.inquirerId is string &&
        request.resource.data.inquirerId == request.auth.uid &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.allowContact is bool &&
        request.resource.data.sourceScreen is string &&
        request.resource.data.platform is string &&
        request.resource.data.status is string;

      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // User Private (phone hash and other sensitive data - writes only through server callable)
    // -----------------------------------------------------------------------
    match /userPrivate/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // User Private Verifications
    // Identity-verification source data and identifiers are server-only.
    // -----------------------------------------------------------------------
    match /userPrivateVerifications/{uid} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Phone Hash Index (reverse matching - server/admin only)
    // -----------------------------------------------------------------------
    match /phoneHashIndex/{phoneHash} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Contact Blocked Hash Index (contact block reverse index - server/admin only)
    // -----------------------------------------------------------------------
    match /contactBlockedHashIndex/{phoneHash} {
      allow read, write: if false;
      match /owners/{ownerUid} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------------
    // AI Profiles (dummy profile metadata such as height, for AI preference screens)
    // -----------------------------------------------------------------------
    match /ai_profiles/{profileId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Model Recs (AI recommendation results: rrf, clip, svd, knn - stored by server, read by app)
    // Reads may be allowed when Kakao login leaves request.auth null.
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` — 누구나 임의 사용자의 추천 결과를 읽을 수
    // 있었다. 추천 결과에는 candidateUid 목록과 source score 가 들어간다.
    match /modelRecs/{userId}/daily/{dateKey}/sources/{algo} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Asks (anonymous questions: 1:1 question)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` 로 전체 무물 내용이 공개였고, create 에
    // request.auth 조건이 없어서 fromUserId 를 위조해 남의 이름으로 질문을
    // 보낼 수 있었다. update 도 아무나 상태를 바꿀 수 있었다.
    match /asks/{askId} {
      allow read: if isAskParticipant(resource.data);

      allow create: if
        isSignedIn() &&
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.status == 'sent';

      allow update: if
        isSignedIn() &&
        resource.data.toUserId == request.auth.uid &&
        resource.data.status == 'sent' &&
        request.resource.data.status == 'read' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'readAt', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Interactions (like / nope / view / message)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` 로 전체 like/nope 기록이 공개였고, create 에
    // request.auth 조건이 없어서 fromUserId 를 위조할 수 있었다. 위조된 like 는
    // onInteractionCreated(index.ts:2304)를 통해 실제 매치와 채팅방을 만들었다.
    match /interactions/{interactionId} {
      allow read: if isInteractionParticipant(resource.data);
      allow create: if
        isSignedIn() &&
        request.resource.data.fromUserId is string &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0 &&
        request.resource.data.action is string &&
        request.resource.data.source is string &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'action', 'source',
          'metadata', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Matches (match records)
    // -----------------------------------------------------------------------
    // 이전: `allow read: if true` — 누구나 전체 매치 기록을 볼 수 있었다.
    match /matches/{matchId} {
      allow read: if isMatchParticipant(resource.data);
      allow create: if false;
      allow update: if isMatchParticipant(resource.data) &&
        matchStatusOnlyMovesToUnmatched();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Event 3-person teams (invites/status - writes only by Cloud Functions, reads for app sync)
    // -----------------------------------------------------------------------
    match /eventTeamSetups/{teamSetupId} {
      allow read: if isEventTeamSetupParticipant(resource.data);
      allow write: if false;
    }

    match /eventTeamInvites/{inviteId} {
      allow read: if isEventTeamInviteParticipant(resource.data);
      allow write: if false;
    }

    match /eventTeamMatches/{matchId} {
      allow read: if isEventTeamMatchParticipant(resource.data);
      allow write: if false;
    }

    match /eventTeamMatchLocks/{lockId} {
      allow read, write: if false;
    }

    match /eventTeamMeetingRequests/{requestId} {
      allow read: if isEventTeamMatchParticipant(resource.data);
      allow write: if false;
    }

    match /eventTeamMeetingRequestLocks/{lockId} {
      allow read, write: if false;
    }

    match /eventThreeVsThreeMatches/{matchId} {
      allow read: if isEventTeamMatchParticipant(resource.data);
      allow write: if false;
    }

    // AUTHENTICATED_LIMITED_PROFILE — server-synced display surface only.
    // Never store email, studentEmail, preferenceVector, tokens, or
    // moderation internals here.
    match /publicProfiles/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Season meeting money/ops — Admin SDK / callables only.
    match /seasonDepositIntents/{intentId} {
      allow read, write: if false;
    }
    match /seasonMeetingCancelAudit/{id} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
