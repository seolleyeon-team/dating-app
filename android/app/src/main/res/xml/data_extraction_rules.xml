<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup and device-to-device transfer rules.

  Nothing this app stores locally may leave the device: the Firebase Auth
  session, the cached appUserId and Yonsei email, onboarding drafts, the
  safety-stamp location log, pending invite/verification tokens (all in
  SharedPreferences) and the Firestore offline cache (chat and profile
  documents, in the database domain). The server is the source of truth for
  every one of them, so a new device signs in again and re-syncs.

  `android:allowBackup="false"` alone does NOT stop device-to-device transfer
  for apps targeting API 31+, hence the explicit <device-transfer> section.
  test/android_backup_contract_test.dart pins this file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
