ENVIRONMENT=staging
SOURCE_PHOTO_BUCKET=seolleyeon-festival-private-source-photos
CHAT_PROFILE_PHOTO_BUCKET=seolleyeon-festival-chat-profile-photos
APPROVED_AVATAR_BUCKET=seolleyeon-festival-approved-avatars
AVATAR_TEMP_BUCKET=seolleyeon-festival-avatar-temp
WRITE_LEGACY_ONBOARDING_PHOTO_URLS=false
CHAT_REAL_PHOTO_SIGNED_URL_TTL_SECONDS=300

# Avatar worker cost guard defaults used by staging Cloud Run deployment.
CLOUD_RUN_VCPU=8
CLOUD_RUN_MEMORY_GIB=32
AVATAR_COST_ALERT_DAILY_USD=10
AVATAR_COST_ALERT_MONTHLY_USD=200
AVATAR_COST_HARD_DAILY_GENERATION_LIMIT=500
AVATAR_COST_HARD_MONTHLY_GENERATION_LIMIT=10000
AVATAR_COST_ENFORCE_BUDGET=true
AVATAR_COST_KILL_SWITCH_ENABLED=false

# Avatar generation queue/worker staging config.
# For avatar-only onboarding smoke, deploy the avatar worker first and set
# CLIP_EMBEDDING_QUEUE_ENABLED=false until the CLIP worker is deployed.
# For the full recommendation/embedding pipeline, deploy the CLIP worker and
# fill the CLIP_* values below before setting CLIP_EMBEDDING_QUEUE_ENABLED=true.
JOB_QUEUE_MODE=cloud_tasks
CLOUD_TASKS_PROJECT=seolleyeon-festival
GCP_LOCATION=asia-northeast3
AVATAR_GENERATION_QUEUE_NAME=avatar-generation
AVATAR_GENERATION_TASK_URL=https://AVATAR_WORKER/tasks/avatar-generation
TASK_INVOKER_SERVICE_ACCOUNT=task-invoker@seolleyeon-festival.iam.gserviceaccount.com
AVATAR_QUEUE_DISPATCH_DEADLINE_SECONDS=1800
AVATAR_QUEUE_MAX_DISPATCHES_PER_SECOND=1
AVATAR_QUEUE_MAX_CONCURRENT_DISPATCHES=1
AVATAR_QUEUE_MAX_ATTEMPTS=3
AVATAR_QUEUE_MIN_BACKOFF_SECONDS=30
AVATAR_QUEUE_MAX_BACKOFF_SECONDS=600
AVATAR_QUEUE_MAX_DOUBLINGS=5
AVATAR_QUEUE_GPU_MAX_CONCURRENT_JOBS=1
AVATAR_QUEUE_TERMINAL_STRATEGY=firestore_failed_status_quarantine_after_max_attempts
# Set false only for avatar-flow staging smoke when the CLIP worker is not deployed yet.
CLIP_EMBEDDING_QUEUE_ENABLED=false

# Full CLIP queue/worker config. Required only when CLIP_EMBEDDING_QUEUE_ENABLED=true.
CLIP_EMBEDDING_QUEUE_NAME=clip-embedding
CLIP_EMBEDDING_TASK_URL=https://CLIP_WORKER/tasks/clip-embedding
# Optional only when the worker validates a custom audience instead of the task URL.
TASK_OIDC_AUDIENCE=https://AVATAR_WORKER

# Staging avatar worker Cloud Run env. Keep these in the staging project only.
AVATAR_REFERENCE_PRIVACY_PREPROCESS=true
AVATAR_REFERENCE_DOWNSAMPLE_SIZE=24
AVATAR_REFERENCE_BLUR_RADIUS=4.0
AVATAR_QA_ALLOW_STAGING_HEURISTIC_PREVIEW=true
AVATAR_QA_FACE_SIMILARITY_REVIEW_THRESHOLD=0.68
AVATAR_QA_FACE_SIMILARITY_REJECT_THRESHOLD=0.72
