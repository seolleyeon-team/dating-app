{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "seolleyeon",
          "appId": "1:623093454373:android:5fa5e4cf627b54d60251cc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "seolleyeon",
          "configurations": {
            "android": "1:623093454373:android:5fa5e4cf627b54d60251cc",
            "ios": "1:623093454373:ios:fa6d8e4c2cc2b0890251cc"
          }
        }
      }
    }
  },
  "functions": [
    {
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "site": "seolleyeon",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/invite/friend",
        "destination": "/invite-friend.html"
      },
      {
        "source": "/invite/friend/**",
        "destination": "/invite-friend.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/**",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/legal/terms.html"
      },
      {
        "source": "/terms/**",
        "destination": "/legal/terms.html"
      },
      {
        "source": "/kakao-review",
        "destination": "/kakao-review.html"
      },
      {
        "source": "/kakao-review/**",
        "destination": "/kakao-review.html"
      },
      {
        "source": "/review",
        "destination": "/kakao-review.html"
      },
      {
        "source": "/review/**",
        "destination": "/kakao-review.html"
      },
      {
        "source": "/signup-guide",
        "destination": "/signup-guide.html"
      },
      {
        "source": "/signup-guide/**",
        "destination": "/signup-guide.html"
      },
      {
        "source": "/auth/email-link",
        "destination": "/auth-email-link.html"
      },
      {
        "source": "/auth/email-link/**",
        "destination": "/auth-email-link.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {}
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}